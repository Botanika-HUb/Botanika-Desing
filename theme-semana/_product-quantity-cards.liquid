{% liquid
assign product = closest.product
assign current_variant = product.selected_or_first_available_variant
assign unit_price = current_variant.price
assign bs = block.settings
assign installments = bs.installments
assign show_currency = settings.show_currency_code
assign fst = bs.free_shipping_threshold | default: 199.90
assign free_ship = fst | times: 100
%}
{%- comment -%}
  Removido o bônus de 8% da Semana Fitness (campanha de agosto).
  Ele somava 8 pontos ao desconto EXIBIDO quando o destaque de campanha
  estava ligado, sem nenhum desconto correspondente na Shopify — ou seja,
  mostrava na vitrine um preço que o checkout não cobraria.
  O percentual exibido aqui vem apenas dos tiers configurados.
{%- endcomment -%}
{%- assign t1_eff = bs.tier1_discount -%}
{%- assign t2_eff = bs.tier2_discount -%}
{%- assign t3_eff = bs.tier3_discount -%}
{%- assign t1_sub = bs.tier1_subtitle -%}
{%- assign t2_sub = bs.tier2_subtitle -%}
{%- assign t3_sub = bs.tier3_subtitle -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap">
<quantity-discount-cards
class="qty2"
data-unit-price="{{ unit_price }}"
data-installments="{{ installments }}"
data-money-format="{{ shop.money_format | escape }}"
data-free-ship="{{ free_ship }}"
{{ block.shopify_attributes }}
>
{%- if bs.sp_enabled -%}
<div class="qty2__sp">
<span class="qty2__stars" aria-hidden="true">★★★★★</span>
{%- if bs.sp_rating != blank -%}<span class="qty2__rating">{{ bs.sp_rating }}</span>{%- endif -%}
{%- if bs.sp_text != blank -%}<span class="qty2__sptx">{{ bs.sp_text }}</span>{%- endif -%}
</div>
{%- endif -%}
{%- comment -%} ===== Barra real de frete grátis ===== {%- endcomment -%}
<div class="qty2__ship" data-ship>
<div class="qty2__ship-top"><span class="qty2__truck">🚚</span><span data-ship-msg></span></div>
<div class="qty2__ship-track"><div class="qty2__ship-fill" data-ship-fill></div></div>
<div class="qty2__ship-scale"><span>R$0</span><span class="qty2__ship-goal" data-ship-goal>Frete grátis · {% if show_currency %}{{ free_ship | money_with_currency }}{% else %}{{ free_ship | money }}{% endif %}</span></div>
</div>
<fieldset class="qty2__fs">
<legend class="qty2__legend"><span>{{ bs.legend_label }}</span> <b class="qty2__legend-val"></b></legend>
<div class="qty2__grid">
{%- assign order = '3,2,1' | split: ',' -%}
{%- assign active_done = false -%}
{%- for n in order -%}
{%- liquid
case n
when '1'
assign q = bs.tier1_quantity
assign eff = t1_eff
assign title = bs.tier1_title
assign sub = t1_sub
assign badge1 = bs.tier1_badge1
assign msg = bs.tier1_message
assign bonus = bs.tier1_bonus
assign setimg = bs.tier1_image
assign metaimg = product.metafields.custom.qty_tier1_image.value
assign enabled = bs.tier1_enabled
when '2'
assign q = bs.tier2_quantity
assign eff = t2_eff
assign title = bs.tier2_title
assign sub = t2_sub
assign badge1 = bs.tier2_badge1
assign msg = bs.tier2_message
assign bonus = bs.tier2_bonus
assign setimg = bs.tier2_image
assign metaimg = product.metafields.custom.qty_tier2_image.value
assign enabled = bs.tier2_enabled
when '3'
assign q = bs.tier3_quantity
assign eff = t3_eff
assign title = bs.tier3_title
assign sub = t3_sub
assign badge1 = bs.tier3_badge1
assign msg = bs.tier3_message
assign bonus = bs.tier3_bonus
assign setimg = bs.tier3_image
assign metaimg = product.metafields.custom.qty_tier3_image.value
assign enabled = bs.tier3_enabled
endcase
-%}
{%- if enabled -%}
{%- liquid
assign c_total = unit_price | times: q
assign c_disc_amt = c_total | times: eff | divided_by: 100
assign c_price = c_total | minus: c_disc_amt
assign c_installment = c_price | divided_by: installments
assign c_unit = c_price | divided_by: q
assign c_free = false
if c_price >= free_ship
assign c_free = true
endif
assign is_active = false
unless active_done
assign is_active = true
assign active_done = true
endunless
-%}
<div class="qty2__opt{% if is_active %} is-active{% endif %}" data-tier="{{ n }}" data-quantity="{{ q }}" data-discount="{{ eff }}" role="radio" aria-checked="{% if is_active %}true{% else %}false{% endif %}" tabindex="0">
{%- if badge1 != blank -%}<span class="qty2__badge">{{ badge1 }}</span>{%- endif -%}
<span class="qty2__check"></span>
<div class="qty2__jar">
{%- if metaimg != blank -%}{{ metaimg | image_url: width: 260 | image_tag: loading: 'lazy', class: 'qty2__img' }}
{%- elsif setimg != blank -%}{{ setimg | image_url: width: 260 | image_tag: loading: 'lazy', class: 'qty2__img' }}
{%- elsif product.featured_image -%}{{ product.featured_image | image_url: width: 260 | image_tag: loading: 'lazy', class: 'qty2__img' }}
{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'qty2__img' }}{%- endif -%}
</div>
<div class="qty2__b">
<div class="qty2__t"><span class="qty2__q">{{ title }}</span><span class="qty2__per" data-perunit>{% if show_currency %}{{ c_unit | money_with_currency }}{% else %}{{ c_unit | money }}{% endif %}/pote</span></div>
<div class="qty2__pills">
{%- if eff > 0 -%}<span class="qty2__pill qty2__pill--off">{{ eff }}% OFF</span>{%- else -%}<span class="qty2__pill qty2__pill--reg">preço regular</span>{%- endif -%}
<span class="qty2__pill qty2__pill--free" data-freeship{% unless c_free %} hidden{% endunless %}>🚚 frete grátis</span>
</div>
{%- if sub != blank -%}<span class="qty2__sub">{{ sub }}</span>{%- endif -%}
<div class="qty2__price"><div class="qty2__parc"><span class="qty2__x">{{ installments }}x de </span><span class="qty2__big" data-installment>{% if show_currency %}{{ c_installment | money_with_currency }}{% else %}{{ c_installment | money }}{% endif %}</span><span class="qty2__semjuros">sem juros</span></div><div class="qty2__cash">ou <b data-total>{% if show_currency %}{{ c_price | money_with_currency }}{% else %}{{ c_price | money }}{% endif %}</b> à vista{%- if eff > 0 -%} <s class="qty2__cmp" data-compare>{% if show_currency %}{{ c_total | money_with_currency }}{% else %}{{ c_total | money }}{% endif %}</s>{%- endif -%}</div></div>
{%- if eff > 0 -%}<span class="qty2__save" data-save>você economiza {% if show_currency %}{{ c_disc_amt | money_with_currency }}{% else %}{{ c_disc_amt | money }}{% endif %}</span>{%- endif -%}
</div>
{%- if bonus != blank -%}<div class="qty2__bonus">🎁 {{ bonus }}</div>{%- endif -%}
{%- if msg != blank -%}<div class="qty2__msg">{{ msg }}</div>{%- endif -%}
</div>
{%- endif -%}
{%- endfor -%}
</div>
</fieldset>
</quantity-discount-cards>
{% stylesheet %}
quantity-discount-cards.qty2{
--q-ink:#2B1607; --q-blue:#E2560E; --q-blue2:#FBBF24; --q-muted:#8a7666; --q-line:#F1E3D3;
--q-sel:#FFF6EC; --q-gold:#FBBF24; --q-gold-ink:#4a3708; --q-ok:#0D9488; --q-ok-tint:#E6F6F4;
display:block;
}
.qty2__sp{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin:0 0 12px;font-size:13px;color:var(--q-muted);}
.qty2__stars{color:#f4b325;letter-spacing:1px;font-size:15px;line-height:1;}
.qty2__rating{font-weight:800;color:var(--q-ink);}
.qty2__ship{background:#fff;border:1.5px solid var(--q-line);border-radius:18px;padding:15px 17px 16px;margin:0 0 18px;}
.qty2__ship-top{font-family:'Fraunces',Georgia,serif;font-size:15.5px;font-weight:600;color:var(--q-ink);margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.qty2__truck{font-size:17px;line-height:1;}
.qty2__ship [data-ship-msg] .amt,.qty2__ship .amt{color:var(--q-blue);font-weight:800;}
.qty2__ship.is-done .amt{color:var(--q-ok);}
.qty2__ship-track{position:relative;height:11px;border-radius:99px;background:#e7ebf8;overflow:hidden;}
.qty2__ship-fill{position:absolute;inset:0 auto 0 0;width:0;border-radius:99px;background:linear-gradient(90deg,var(--q-blue),var(--q-blue2));transition:width .5s cubic-bezier(.22,.61,.36,1);}
.qty2__ship.is-done .qty2__ship-fill{background:linear-gradient(90deg,var(--q-ok),#37c26e);}
.qty2__ship-scale{display:flex;justify-content:space-between;margin-top:8px;font-size:10.5px;color:var(--q-muted);font-weight:700;font-variant-numeric:tabular-nums;}
.qty2__ship.is-done .qty2__ship-goal{color:var(--q-ok);}
.qty2__fs{border:0;padding:0;margin:0 0 4px;}
.qty2__legend{font-size:13px;color:var(--q-muted);margin:0 0 12px;display:block;}
.qty2__legend-val{color:var(--q-ink);}
.qty2__grid{display:flex;flex-direction:column;gap:12px;}
.qty2__opt{position:relative;display:grid;grid-template-columns:26px 62px 1fr;gap:13px;align-items:center;background:#fff;border:2px solid var(--q-line);border-radius:18px;padding:15px 15px;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s;}
.qty2__opt:hover{border-color:var(--q-blue);}
.qty2__opt.is-active{border-color:var(--q-blue);background:var(--q-sel);box-shadow:0 8px 22px rgba(194,65,12,.16);}
.qty2__check{width:26px;height:26px;border-radius:50%;border:2px solid #cdd3e6;display:grid;place-items:center;transition:.18s;}
.qty2__opt.is-active .qty2__check{border-color:var(--q-blue);background:var(--q-blue);}
.qty2__check::after{content:"";width:6px;height:12px;border:solid #fff;border-width:0 3px 3px 0;transform:rotate(45deg) scale(0);margin-top:-2px;transition:.18s;}
.qty2__opt.is-active .qty2__check::after{transform:rotate(45deg) scale(1);}
.qty2__jar{width:62px;height:62px;display:grid;place-items:center;}
.qty2__img{width:100%;height:100%;object-fit:contain;}
.qty2__b{min-width:0;}
.qty2__t{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;}
.qty2__q{font-family:'Fraunces',Georgia,serif;font-size:17px;font-weight:600;color:var(--q-ink);line-height:1.1;}
.qty2__per{font-size:12px;color:var(--q-muted);font-weight:600;}
.qty2__pills{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 6px;}
.qty2__pill{font-size:11px;font-weight:800;padding:3px 10px;border-radius:99px;line-height:1.35;white-space:nowrap;}
.qty2__pill--off{background:var(--q-blue);color:#fff;}
.qty2__pill--free{background:var(--q-ok-tint);color:var(--q-ok);}
.qty2__pill--reg{background:#eef1f9;color:var(--q-muted);}
.qty2__sub{display:block;font-size:12px;color:var(--q-muted);margin-bottom:6px;}
.qty2__price{font-variant-numeric:tabular-nums;display:flex;flex-direction:column;gap:1px;}
.qty2__parc{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px;font-size:12px;color:var(--q-muted);line-height:1.15;}
.qty2__big{font-size:22px;font-weight:900;color:var(--q-blue);letter-spacing:-.02em;}
.qty2__semjuros{font-size:10px;font-weight:800;background:#FFF1DC;color:#8a5a12;border-radius:4px;padding:1px 6px;}
.qty2__cash{font-size:12.5px;color:var(--q-muted);line-height:1.3;}
.qty2__cash b{color:var(--q-ink);font-weight:800;}
.qty2__cmp{color:#b8a493;text-decoration:line-through;margin-left:5px;}
.qty2__save{display:inline-block;margin-top:4px;font-size:11.5px;font-weight:800;color:var(--q-ok);}
.qty2__badge{position:absolute;top:-11px;right:16px;font-size:10.5px;font-weight:800;padding:4px 12px;border-radius:99px;letter-spacing:.02em;background:var(--q-blue);color:#fff;box-shadow:0 4px 10px rgba(194,65,12,.28);}
.qty2__opt[data-tier="3"] .qty2__badge{background:var(--q-gold);color:var(--q-gold-ink);box-shadow:0 4px 10px rgba(200,150,20,.3);}
.qty2__bonus{grid-column:1 / -1;display:flex;align-items:center;gap:8px;margin-top:4px;background:#fff8e6;border:1px dashed var(--q-gold);color:#7a5a12;font-weight:800;font-size:12px;padding:9px 12px;border-radius:12px;line-height:1.3;}
.qty2__msg{grid-column:1 / -1;margin-top:4px;background:var(--q-blue);color:#fff;font-size:12px;font-weight:700;padding:6px 12px;border-radius:8px;text-align:center;}
@media (max-width:749px){
.qty2__opt{grid-template-columns:24px 52px 1fr;gap:11px;padding:14px 13px;}
.qty2__jar{width:52px;height:52px;}
.qty2__q{font-size:16px;}
}
@media (prefers-reduced-motion:reduce){.qty2__ship-fill,.qty2__check::after,.qty2__opt{transition:none;}}
{% endstylesheet %}
{% javascript %}
class QuantityDiscountCards extends HTMLElement {
connectedCallback(){
this.cards = Array.prototype.slice.call(this.querySelectorAll('.qty2__opt'));
this.installments = parseInt(this.dataset.installments) || 3;
this.moneyFormat = this.dataset.moneyFormat || '';
this.freeShip = parseInt(this.dataset.freeShip) || 19990;
this.legendVal = this.querySelector('.qty2__legend-val');
this.ship = this.querySelector('[data-ship]');
this.shipFill = this.querySelector('[data-ship-fill]');
this.shipMsg = this.querySelector('[data-ship-msg]');
var self = this;
this.cards.forEach(function(card){
card.addEventListener('click', function(){ self.select(card); });
card.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); self.select(card); } });
});
this.observeVariant();
var active = this.querySelector('.qty2__opt.is-active') || this.cards[0];
if(active){ this.apply(active); this.legend(active); this.updateShip(active); }
}
apply(card){
var qty = parseInt(card.dataset.quantity);
var section = this.closest('[id^="shopify-section-"]');
var input = section ? section.querySelector('input.quantity-input') : document.querySelector('input.quantity-input');
if(input){ input.value = qty; input.dispatchEvent(new Event('change',{bubbles:true})); }
}
select(card){
this.cards.forEach(function(c){ c.classList.remove('is-active'); c.setAttribute('aria-checked','false'); });
card.classList.add('is-active'); card.setAttribute('aria-checked','true');
this.apply(card); this.legend(card); this.updateShip(card);
}
legend(card){ if(this.legendVal){ var t=card.querySelector('.qty2__q'); this.legendVal.textContent = t ? t.textContent.trim() : ''; } }
priceOf(card){
var qty=parseInt(card.dataset.quantity), disc=parseInt(card.dataset.discount), unit=parseInt(this.dataset.unitPrice);
var total=unit*qty; return total - Math.floor(total*disc/100);
}
updateShip(card){
if(!this.ship) return;
var price=this.priceOf(card);
var pct=Math.min(100, Math.round(price/this.freeShip*100));
if(this.shipFill) this.shipFill.style.width = pct+'%';
if(price>=this.freeShip){
this.ship.classList.add('is-done');
if(this.shipMsg) this.shipMsg.innerHTML='<span class="amt">Frete grátis desbloqueado!</span> 🎉';
} else {
this.ship.classList.remove('is-done');
if(this.shipMsg) this.shipMsg.innerHTML='Faltam <span class="amt">'+this.money(this.freeShip-price)+'</span> para o frete grátis';
}
}
observeVariant(){
var self=this, section=this.closest('[id^="shopify-section-"]');
var vinput = section ? section.querySelector('input.product-variant-id') : document.querySelector('input.product-variant-id');
var pjson = section ? section.querySelector('.productJson') : document.querySelector('.productJson');
if(!vinput||!pjson) return;
var data; try{ data=JSON.parse(pjson.textContent); }catch(e){ return; }
var upd=function(){ var id=parseInt(vinput.value); var v=data.variants.find(function(x){return x.id===id;}); if(v) self.reprice(v.price); };
new MutationObserver(upd).observe(vinput,{attributes:true,attributeFilter:['value']});
vinput.addEventListener('change',upd);
}
reprice(unit){
var self=this; this.dataset.unitPrice=unit;
this.cards.forEach(function(card){
var qty=parseInt(card.dataset.quantity), disc=parseInt(card.dataset.discount);
var total=unit*qty, damt=Math.floor(total*disc/100), price=total-damt;
var per=Math.floor(price/qty), inst=Math.floor(price/self.installments), free=price>=self.freeShip;
var set=function(s,v){var el=card.querySelector(s); if(el) el.textContent=v;};
set('[data-installment]', self.money(inst)); set('[data-total]', self.money(price));
set('[data-compare]', self.money(total)); set('[data-perunit]', self.money(per)+'/pote');
var sv=card.querySelector('[data-save]'); if(sv) sv.textContent='você economiza '+self.money(damt);
var fs=card.querySelector('[data-freeship]'); if(fs) fs.hidden=!free;
});
var active=this.querySelector('.qty2__opt.is-active'); if(active) this.updateShip(active);
}
money(cents){
var a=(cents/100).toFixed(2), p=a.split('.'), ip=p[0].replace(/\B(?=(\d{3})+(?!\d))/g,'.'), dp=p[1], f=this.moneyFormat;
var m=function(k){return String.fromCharCode(123,123)+k+String.fromCharCode(125,125);};
return f.replace(m('amount_with_comma_separator'),ip+','+dp).replace(m('amount_no_decimals_with_comma_separator'),ip).replace(m('amount_no_decimals'),p[0]).replace(m('amount'),a);
}
}
customElements.define('quantity-discount-cards', QuantityDiscountCards);
{% endjavascript %}
