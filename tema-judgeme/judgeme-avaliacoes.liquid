{% comment %} Judge.me - Avaliacoes (PDP) - Botanika (custom, inspirado no widget nativo) {% endcomment %}
<style>
  .bkjm{--brand:#323c91;--gold:#f5b400;--muted:#737a99;--line:#eceef5;--green:#10c322;max-width:{{ section.settings.max_width | default: 1040 }}px;margin:0 auto;padding:{{ section.settings.padding_top | default: 52 }}px 20px {{ section.settings.padding_bottom | default: 52 }}px;font-family:inherit;color:#2a2f45;}
  .bkjm *{box-sizing:border-box;}
  .bkjm__title{text-align:center;color:var(--brand);font-weight:800;font-size:30px;line-height:1.1;margin:0 0 4px;letter-spacing:-.01em;}
  .bkjm__sub{text-align:center;color:var(--muted);font-size:15px;margin:0 0 30px;}
  /* Summary */
  .bkjm__summary{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:20px 40px;padding-bottom:24px;border-bottom:1px solid var(--line);}
  .bkjm__score{text-align:center;}
  .bkjm__score-num{font-size:54px;font-weight:800;color:var(--brand);line-height:1;}
  .bkjm__stars{display:inline-flex;gap:3px;margin-top:8px;font-size:19px;line-height:1;}
  .bkjm__stars .on{color:var(--gold);}
  .bkjm__stars .off{color:#d7dae8;}
  .bkjm__count{color:var(--muted);font-size:13px;margin-top:8px;}
  .bkjm__hist{display:flex;flex-direction:column;gap:6px;max-width:360px;width:100%;}
  .bkjm__hrow{display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--muted);}
  .bkjm__hrow b{color:var(--brand);width:9px;text-align:center;font-weight:700;}
  .bkjm__hrow .s{color:var(--gold);font-size:12px;}
  .bkjm__bar{flex:1;height:8px;background:#eef0f6;border-radius:99px;overflow:hidden;}
  .bkjm__bar span{display:block;height:100%;background:var(--gold);border-radius:99px;}
  .bkjm__hc{width:22px;text-align:right;color:#4a5079;font-variant-numeric:tabular-nums;}
  .bkjm__cta a{display:inline-block;background:var(--green);color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:13px 24px;border-radius:{{ settings.rounded_corner | default: 12 }}px;box-shadow:0 6px 16px rgba(16,195,34,.22);white-space:nowrap;}
  /* List */
  .bkjm__meta{color:var(--muted);font-size:12.5px;margin:20px 0 0;}
  .bkjm .jdgm-ssr-ai-content,.bkjm .jdgm-ssr-rating-distribution,.bkjm .jdgm-rev__transparency-badge-wrapper,.bkjm .jdgm-rev__buyer-badge,.bkjm .jdgm-rev__icon,.bkjm .jdgm-rev__br,.bkjm .jdgm-rev__actions,.bkjm .jdgm-spinner{display:none !important;}
  .bkjm .jdgm-rev{border-top:1px solid var(--line);padding:22px 0;}
  .bkjm .jdgm-rev__header{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;}
  .bkjm .jdgm-rev__rating{order:1;font-size:15px;letter-spacing:1px;white-space:nowrap;}
  .bkjm .jdgm-star.jdgm--on{color:var(--gold) !important;}
  .bkjm .jdgm-star.jdgm--off{color:#d7dae8 !important;}
  .bkjm .jdgm-rev__author-wrapper{order:2;display:inline-flex;align-items:baseline;gap:6px;}
  .bkjm .jdgm-rev__author{font-weight:700;color:#20295c;font-size:14px;}
  .bkjm .jdgm-rev__location{color:var(--muted);font-size:12px;}
  .bkjm .jdgm-rev[data-verified-buyer='true'] .jdgm-rev__buyer-badge-wrapper{order:3;display:inline-flex;}
  .bkjm .jdgm-rev[data-verified-buyer='true'] .jdgm-rev__buyer-badge-wrapper::before{content:"\2713 Compra verificada";display:inline-block;background:#e8f5ec;color:#1f8a4c;font-size:11px;font-weight:600;padding:2px 9px;border-radius:999px;white-space:nowrap;}
  .bkjm .jdgm-rev__timestamp{order:4;margin-left:auto;color:var(--muted);font-size:12.5px;}
  .bkjm .jdgm-rev__content{margin-top:8px;}
  .bkjm .jdgm-rev__title{display:block;color:#20295c;font-weight:700;font-size:15px;margin:2px 0 3px;}
  .bkjm .jdgm-rev__title:empty{display:none;}
  .bkjm .jdgm-rev__body{color:#3a3f57;line-height:1.55;font-size:14.5px;}
  .bkjm .jdgm-rev__body p{margin:0;}
  /* Midia (fotos/videos) abaixo do texto, tamanho controlado e responsivo */
  .bkjm .jdgm-rev__pics,.bkjm .jdgm-rev__vids{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;}
  .bkjm .jdgm-rev__pics img{width:92px !important;height:92px !important;max-width:100% !important;object-fit:cover;border-radius:10px;}
  .bkjm .jdgm-vid-player{width:150px !important;max-width:100% !important;height:auto !important;border-radius:10px;overflow:hidden;}
  .bkjm .jdgm-vid-player__wrapper{width:100% !important;height:auto !important;aspect-ratio:9/16;}
  .bkjm .jdgm-vid-player video,.bkjm .jdgm-vid-player iframe,.bkjm .jdgm-vid-player img{width:100% !important;height:100% !important;object-fit:cover;}
  @media(max-width:640px){.bkjm__title{font-size:23px;}.bkjm__summary{grid-template-columns:1fr;justify-items:center;text-align:center;gap:18px;}.bkjm__hist{max-width:320px;}.bkjm__cta{width:100%;}.bkjm__cta a{display:block;text-align:center;}.bkjm .jdgm-rev__timestamp{margin-left:0;flex-basis:100%;order:5;}}
</style>
{%- assign ratingobj = product.metafields.reviews.rating.value -%}
{%- assign r = ratingobj.rating -%}
{%- assign rc = product.metafields.reviews.rating_count.value -%}
{%- assign ssr = product.metafields.judgeme.review_widget_ssr_html -%}
<div id="avaliacoes" class="bkjm jdgm-widget jdgm-review-widget" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" {{ section.shopify_attributes }}>
  {%- if section.settings.heading != blank -%}<h2 class="bkjm__title">{{ section.settings.heading }}</h2>{%- endif -%}
  {%- if section.settings.subheading != blank -%}<p class="bkjm__sub">{{ section.settings.subheading }}</p>{%- endif -%}
  {%- if rc and rc > 0 -%}
    {%- assign filled = r | round -%}
    <div class="bkjm__summary">
      <div class="bkjm__score">
        <div class="bkjm__score-num">{{ r }}</div>
        <div class="bkjm__stars">{% for i in (1..5) %}<span class="{% if i <= filled %}on{% else %}off{% endif %}">★</span>{% endfor %}</div>
        <div class="bkjm__count">{{ rc }} {% if rc == 1 %}avaliação{% else %}avaliações{% endif %}</div>
      </div>
      <div class="bkjm__hist">
        {%- assign lis = ssr | split: '<li>' -%}
        {%- for li in lis -%}
          {%- if li contains 'star' and li contains '%)' -%}
            {%- assign lvl = li | split: ' star' | first | strip -%}
            {%- assign cnt = li | split: ': ' | last | split: ' (' | first | strip -%}
            {%- assign p = li | split: '(' | last | split: '%' | first | strip -%}
            <div class="bkjm__hrow"><b>{{ lvl }}</b><span class="s">★</span><span class="bkjm__bar"><span style="width:{{ p }}%"></span></span><span class="bkjm__hc">{{ cnt }}</span></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.show_cta -%}<div class="bkjm__cta"><a href="{{ product.url }}#judgeme_product_reviews">{{ section.settings.cta_label | default: 'Escreva uma avaliação' }}</a></div>{%- endif -%}
    </div>
    {%- if rc > 7 -%}<p class="bkjm__meta">Mostrando as avaliações mais recentes — {{ rc }} no total.</p>{%- endif -%}
  {%- endif -%}
  {%- if ssr != blank -%}{{ ssr }}
  {%- elsif product.metafields.judgeme.widget != blank -%}{{ product.metafields.judgeme.widget }}
  {%- else -%}<p style="text-align:center;color:#737a99;padding:14px 0;">Este produto ainda não tem avaliações. Seja o primeiro a avaliar!</p>{%- endif -%}
</div>
{% schema %}
{
  "name": "Judge.me Avaliações",
  "tag": "section",
  "class": "section-judgeme-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Avaliações de quem já usa" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Avaliações reais e verificadas de clientes Botanika." },
    { "type": "checkbox", "id": "show_cta", "label": "Mostrar botão 'Escreva uma avaliação'", "default": true },
    { "type": "text", "id": "cta_label", "label": "Texto do botão", "default": "Escreva uma avaliação" },
    { "type": "range", "id": "max_width", "min": 700, "max": 1200, "step": 10, "unit": "px", "label": "Largura máxima", "default": 1040 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Espaço acima", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Espaço abaixo", "default": 52 }
  ],
  "presets": [ { "name": "Judge.me Avaliações" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
