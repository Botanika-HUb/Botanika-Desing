{%- comment -%}
  Retorna 'yes' se o produto faz parte da campanha.
  Lancamento set/26 encerrado em out/26: a lista fixa de lancamentos foi esvaziada
  (sem contorno nem selo "Lancamento" nos cards).
  Campanha configuravel via Configuracoes do tema continua sendo respeitada.
{%- endcomment -%}
{%- liquid
  assign p = product
  assign match = false
  if settings.camp_active and p != blank
    assign list = settings.camp_handles | default: '' | downcase | replace: ' ', '' | split: ','
    for h in list
      if h == p.handle
        assign match = true
        break
      endif
    endfor
  endif
  if match
    echo 'yes'
  endif
-%}
