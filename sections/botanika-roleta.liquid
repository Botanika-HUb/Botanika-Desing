{%- comment -%}
  ============================================================
  Roleta Botanika: pop-up de captura (e-mail + WhatsApp).

  FLUXO
    1. E-mail obrigatório para liberar o giro.
    2. Roleta gira e para na fatia premiada.
    3. WhatsApp (+55) + consentimento para liberar o cupom.
    4. Cupom na tela com botão de copiar. Ninguém sai do site.

  FATIAS x PRÊMIO (leia antes de mexer)
    As 8 fatias são só o visual. O que a pessoa ganha é decidido por
    "Fatia que sempre ganha":
      · 1 a 8  -> a roleta SEMPRE para nessa fatia. As outras aparecem
                 na roda mas nunca saem. É o padrão do mercado (Omnisend,
                 Wheelio) e foi o formato pedido.
      · 0      -> sorteio real entre todas as fatias que tiverem cupom
                 preenchido. Cada uma sai com a mesma chance.
    Só as fatias que podem sair precisam de cupom. As cores da roda são
    alternadas e não revelam quais fatias são premiadas.

  CAPTURA
    Mesmo pipeline do antigo pop-up de diagnóstico: POST no endpoint
    Cloudflare -> ActiveCampaign, mais o form /contact do Shopify como
    rede de segurança pro e-mail.

  Substitui o "Pop-up Diagnóstico" (sections/botanika-diagnostico.liquid).
  ============================================================
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign show = st.enable
  if st.home_only and request.page_type != 'index'
    assign show = false
  endif
-%}
{%- if show -%}
  {%- assign has_prize = false -%}
  {%- capture slices_json -%}
    {%- for i in (1..8) -%}
      {%- assign lk = 'slice' | append: i | append: '_label' -%}
      {%- assign ck = 'slice' | append: i | append: '_code' -%}
      {%- assign ek = 'slice' | append: i | append: '_emoji' -%}
      {%- if i > 1 -%},{%- endif -%}
      {"label":{{ st[lk] | default: '' | json }},"code":{{ st[ck] | default: '' | json }},"emoji":{{ st[ek] | default: '' | json }}}
      {%- if st[ck] != blank -%}{%- assign has_prize = true -%}{%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if has_prize or request.design_mode -%}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap">

    <div
      id="botanika-roleta"
      data-brl
      data-delay="{{ st.delay_seconds }}"
      data-endpoint="{{ st.lead_endpoint | escape }}"
      data-win="{{ st.win_slice }}"
      hidden
    >
      <div class="brl-ov" role="dialog" aria-modal="true" aria-label="{{ st.heading | escape }}">
        <div class="brl">
          <button class="brl__x" type="button" aria-label="Fechar" data-brl-close>&#10005;</button>

          <div class="brl__wheelwrap">
            <div class="brl__pin" aria-hidden="true"></div>
            <div class="brl__disc" data-brl-disc><span class="brl__sep" aria-hidden="true"></span></div>
            <div class="brl__rim" data-brl-rim aria-hidden="true"></div>
            <div class="brl__hub" aria-hidden="true">🌿</div>
          </div>

          <div class="brl__panel">
            {%- comment -%} 1. e-mail libera o giro {%- endcomment -%}
            <div data-brl-step="1">
              <h2 class="brl__title">{{ st.heading }}</h2>
              <p class="brl__sub">{{ st.subheading }}</p>
              <form data-brl-email-form novalidate>
                <input
                  class="brl__input"
                  type="email"
                  inputmode="email"
                  autocomplete="email"
                  placeholder="{{ st.email_placeholder }}"
                  aria-label="Seu e-mail"
                  data-brl-email
                  required
                >
                <p class="brl__err" data-brl-email-err hidden>Confere o e-mail, parece que faltou alguma coisa.</p>
                <button type="submit" class="brl__cta" data-brl-spin>{{ st.spin_label }}</button>
              </form>
              <p class="brl__fine">{{ st.email_consent }}</p>
            </div>

            {%- comment -%} 2. premio revelado + WhatsApp {%- endcomment -%}
            <div data-brl-step="2" hidden>
              <h2 class="brl__title brl__title--win">
                &#127873; Boa! Você ganhou <b data-brl-prize></b>
              </h2>
              <p class="brl__sub">{{ st.vip_sub }}</p>
              <form data-brl-phone-form novalidate>
                <div class="brl__phone">
                  <span class="brl__ddi">&#127463;&#127479; +55</span>
                  <input
                    class="brl__input brl__input--phone"
                    type="tel"
                    inputmode="numeric"
                    autocomplete="tel-national"
                    placeholder="(11) 90000-0000"
                    aria-label="Seu WhatsApp"
                    data-brl-phone
                  >
                </div>
                <p class="brl__err" data-brl-phone-err hidden>Digite um celular com DDD.</p>
                <label class="brl__check">
                  <input type="checkbox" data-brl-consent>
                  <span>{{ st.vip_consent }}</span>
                </label>
                <button type="submit" class="brl__cta" data-brl-phone-submit>{{ st.vip_button }}</button>
              </form>
            </div>

            {%- comment -%} 3. cupom {%- endcomment -%}
            <div data-brl-step="3" hidden>
              <h2 class="brl__title">{{ st.done_heading }}</h2>
              <p class="brl__sub">{{ st.done_sub }}</p>
              <div class="brl__coupon">
                <div class="brl__coupon-lbl">Seu cupom</div>
                <div class="brl__coupon-row">
                  <span class="brl__coupon-code" data-brl-code>&nbsp;</span>
                  <button type="button" class="brl__coupon-copy" data-brl-copy>Copiar</button>
                </div>
              </div>
              <p class="brl__hint" data-brl-hint></p>
              <button type="button" class="brl__cta brl__cta--ghost" data-brl-close>{{ st.done_button }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script type="application/json" data-brl-slices>[{{ slices_json | strip }}]</script>

    <style>
      #botanika-roleta{--blue:#323C91;--blue-2:#4b57bd;--navy:#15265c;--gold:#f4b325;--ink:#1a2340;--muted:#6b7392;--line:#e6e8f2;--tint:#eef1fb;--ok:#1a8f3c;}
      #botanika-roleta *,#botanika-roleta *::before,#botanika-roleta *::after{box-sizing:border-box;}
      #botanika-roleta[hidden]{display:none!important}
      #botanika-roleta [hidden]{display:none!important}
      #botanika-roleta .brl-ov{position:fixed;top:0;right:0;bottom:0;left:0;inset:0;z-index:99999;background:rgba(15,20,45,.58);backdrop-filter:blur(3px);display:flex;align-items:flex-start;justify-content:center;padding:16px;overflow-y:auto;opacity:0;transition:opacity .25s ease;font-family:'Inter',system-ui,-apple-system,sans-serif;}
      #botanika-roleta.is-open .brl-ov{opacity:1;}
      #botanika-roleta .brl{position:relative;margin:auto;width:100%;max-width:420px;background:#fff;color:var(--ink);border-radius:22px;padding:22px 20px 20px;box-shadow:0 24px 60px -20px rgba(21,38,92,.5);transform:translateY(16px) scale(.98);transition:transform .28s cubic-bezier(.22,.61,.36,1);-webkit-font-smoothing:antialiased;}
      #botanika-roleta.is-open .brl{transform:none;}
      #botanika-roleta .brl__x{position:absolute;top:10px;right:10px;z-index:6;width:32px;height:32px;border:0;border-radius:50%;background:var(--tint);color:var(--muted);cursor:pointer;font-size:14px;line-height:1;display:grid;place-items:center;}
      #botanika-roleta .brl__x:hover{background:var(--line);color:var(--ink);}

      #botanika-roleta .brl__wheelwrap{position:relative;width:250px;height:250px;margin:8px auto 20px;}
      #botanika-roleta .brl__disc{position:absolute;top:0;left:0;width:100%;height:100%;border-radius:50%;box-shadow:0 0 0 5px #fff,0 0 0 16px var(--navy),0 0 0 18px var(--gold),0 14px 30px -10px rgba(21,38,92,.6);transition:transform 5s cubic-bezier(.11,.7,.12,1);}
      #botanika-roleta .brl__lbl{position:absolute;left:50%;top:50%;transform-origin:0 0;font-size:10px;font-weight:800;letter-spacing:.01em;line-height:1.12;text-align:center;pointer-events:none;overflow-wrap:break-word;}
      #botanika-roleta .brl__lbl-ic{display:block;font-size:13px;line-height:1;margin-bottom:3px;filter:drop-shadow(0 1px 1px rgba(0,0,0,.2));}
      #botanika-roleta .brl__sep{position:absolute;top:0;left:0;width:100%;height:100%;border-radius:50%;pointer-events:none;background:repeating-conic-gradient(from 0deg,rgba(255,255,255,.55) 0deg .45deg,transparent .45deg 45deg);}
      #botanika-roleta .brl__rim{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;}
      #botanika-roleta .brl__dot{position:absolute;left:50%;top:50%;width:4px;height:4px;margin:-2px 0 0 -2px;border-radius:50%;background:var(--gold);box-shadow:0 0 3px rgba(244,179,37,.9);}
      #botanika-roleta .brl__hub{position:absolute;top:50%;left:50%;z-index:2;width:48px;height:48px;margin:-24px 0 0 -24px;border-radius:50%;background:#fff;display:grid;place-items:center;font-size:19px;box-shadow:0 0 0 4px var(--gold),0 3px 10px rgba(21,38,92,.45);}
      #botanika-roleta .brl__pin{position:absolute;top:-8px;left:50%;margin-left:-13px;width:26px;height:36px;z-index:5;background:#fff;clip-path:polygon(50% 100%,0 0,100% 0);filter:drop-shadow(0 0 1px var(--navy)) drop-shadow(0 0 2px rgba(21,38,92,.7)) drop-shadow(0 3px 4px rgba(0,0,0,.35));}

      #botanika-roleta .brl__title{font-family:'Fraunces',Georgia,serif;font-size:21px;font-weight:600;line-height:1.18;letter-spacing:-.01em;margin:0 0 6px;text-align:center;text-wrap:balance;}
      #botanika-roleta .brl__title--win b{color:var(--blue);}
      #botanika-roleta .brl__sub{font-size:13px;color:var(--muted);line-height:1.45;margin:0 0 16px;text-align:center;}
      #botanika-roleta .brl__cta{width:100%;border:0;border-radius:12px;background:var(--blue);color:#fff;font:inherit;font-weight:800;font-size:15px;padding:15px;cursor:pointer;transition:background .15s;}
      #botanika-roleta .brl__cta:hover{background:var(--navy);}
      #botanika-roleta .brl__cta:disabled{opacity:.6;cursor:not-allowed;}
      #botanika-roleta .brl__cta--ghost{background:#fff;color:var(--blue);border:1.5px solid var(--line);}
      #botanika-roleta .brl__cta--ghost:hover{background:var(--tint);color:var(--navy);}
      #botanika-roleta .brl__input{width:100%;border:1.5px solid var(--line);border-radius:11px;padding:13px 14px;font:inherit;font-size:16px;color:var(--ink);background:#fff;outline:none;transition:border-color .15s,box-shadow .15s;}
      #botanika-roleta .brl__input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(50,60,145,.12);}
      #botanika-roleta .brl__phone{display:flex;gap:8px;}
      #botanika-roleta .brl__ddi{flex:0 0 auto;display:flex;align-items:center;padding:0 12px;border:1.5px solid var(--line);border-radius:11px;font-size:14px;font-weight:700;color:var(--ink);background:var(--tint);}
      #botanika-roleta .brl__input--phone{flex:1;min-width:0;}
      #botanika-roleta .brl__err{font-size:11.5px;color:#c0392b;margin:7px 0 0;text-align:center;}
      #botanika-roleta .brl__check{display:flex;align-items:flex-start;gap:8px;margin:13px 0;font-size:11.5px;color:var(--muted);line-height:1.4;cursor:pointer;}
      #botanika-roleta .brl__check input{flex:0 0 auto;margin:1px 0 0;width:16px;height:16px;accent-color:var(--blue);}
      #botanika-roleta form .brl__cta{margin-top:13px;}
      #botanika-roleta .brl__fine{font-size:10.5px;color:var(--muted);text-align:center;margin:12px 0 0;line-height:1.45;}
      #botanika-roleta .brl__coupon{border:1.5px dashed var(--blue);background:var(--tint);border-radius:14px;padding:14px;}
      #botanika-roleta .brl__coupon-lbl{font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;}
      #botanika-roleta .brl__coupon-row{display:flex;align-items:center;gap:10px;}
      #botanika-roleta .brl__coupon-code{flex:1;min-width:0;font-family:'Fraunces',Georgia,serif;font-size:21px;font-weight:700;letter-spacing:.04em;color:var(--navy);background:#fff;border:1px solid var(--line);border-radius:10px;padding:9px 12px;text-align:center;overflow:hidden;text-overflow:ellipsis;}
      #botanika-roleta .brl__coupon-copy{flex:0 0 auto;border:0;border-radius:10px;background:var(--blue);color:#fff;font:inherit;font-weight:800;font-size:13px;padding:12px 16px;cursor:pointer;white-space:nowrap;transition:background .15s;}
      #botanika-roleta .brl__coupon-copy:hover{background:var(--navy);}
      #botanika-roleta .brl__coupon-copy.is-ok{background:var(--ok);}
      #botanika-roleta .brl__hint{font-size:11.5px;color:var(--ok);font-weight:700;text-align:center;margin:9px 0 0;min-height:16px;}
      #botanika-roleta .brl__panel .brl__cta--ghost{margin-top:14px;}
      @media (max-width:380px){
        #botanika-roleta .brl__wheelwrap{width:206px;height:206px;}
        #botanika-roleta .brl__title{font-size:19px;}
        #botanika-roleta .brl__lbl{font-size:8.5px;}
        #botanika-roleta .brl__lbl-ic{font-size:11px;}
      }
      @media (prefers-reduced-motion:reduce){
        #botanika-roleta .brl-ov,#botanika-roleta .brl,#botanika-roleta .brl__disc{transition:none!important;}
      }
    </style>

    <script>
      (function () {
        var root = document.getElementById('botanika-roleta');
        if (!root || root.dataset.brlInit === '1') return;
        root.dataset.brlInit = '1';

        var dataEl = document.querySelector('[data-brl-slices]');
        var slices = [];
        try { slices = JSON.parse(dataEl.textContent); } catch (e) { slices = []; }
        if (slices.length !== 8) return;
        if (!slices.some(function (s) { return s.code; })) return;

        var N = slices.length;
        var KEY = 'botanika_roleta_seen';
        var ENDPOINT = root.dataset.endpoint || '';
        var DELAY = (parseInt(root.dataset.delay, 10) || 6) * 1000;
        var WIN = parseInt(root.dataset.win, 10) || 0;
        var WHEEL_COLORS = [{ bg: '#323C91', fg: '#ffffff' }, { bg: '#f4b325', fg: '#15265c' }];

        var q = function (s) { return root.querySelector(s); };
        var disc = q('[data-brl-disc]');

        // medidas da roda (o CSS encolhe a roda abaixo de 380px)
        var small = window.matchMedia && window.matchMedia('(max-width: 380px)').matches;
        var wheel = small ? 206 : 250;
        var inner = small ? 30 : 34;
        var labelW = Math.round(wheel / 2 - inner - 8);
        var rimRadius = Math.round(wheel / 2 + 10);
        var steps = {};
        [1, 2, 3].forEach(function (n) { steps[n] = q('[data-brl-step="' + n + '"]'); });

        var lead = { email: '', phone: '', code: '', label: '' };
        var opened = false, spinning = false, spun = false, rotation = 0;

        function show(n) {
          [1, 2, 3].forEach(function (k) { if (steps[k]) steps[k].hidden = (k !== n); });
        }

        // ---- desenha a roda: indigo e dourado alternados
        var step = 360 / N;
        var stops = [];
        for (var k = 0; k < N; k++) {
          stops.push(WHEEL_COLORS[k % WHEEL_COLORS.length].bg + ' ' + (k * step) + 'deg ' + ((k + 1) * step) + 'deg');
        }
        disc.style.background = 'conic-gradient(' + stops.join(',') + ')';

        // pontinhos dourados no aro (fora do disco, nao giram)
        var rim = q('[data-brl-rim]');
        if (rim) {
          for (var dcount = 0; dcount < 16; dcount++) {
            var dot = document.createElement('span');
            dot.className = 'brl__dot';
            dot.style.transform = 'rotate(' + (dcount * (360 / 16)) + 'deg) translateY(-' + (rimRadius) + 'px)';
            rim.appendChild(dot);
          }
        }

        // o rótulo é um bloco que ocupa a faixa entre o miolo e a borda,
        // centrado na fatia, assim texto longo quebra em vez de vazar da roda
        for (var m = 0; m < N; m++) {
          var span = document.createElement('span');
          span.className = 'brl__lbl';
          span.style.color = WHEEL_COLORS[m % WHEEL_COLORS.length].fg;
          if (slices[m].emoji) {
            var ic = document.createElement('span');
            ic.className = 'brl__lbl-ic';
            ic.textContent = slices[m].emoji;
            span.appendChild(ic);
          }
          span.appendChild(document.createTextNode(slices[m].label || ''));
          span.style.width = labelW + 'px';
          var center = m * step + step / 2;
          span.style.transform = 'rotate(' + (center - 90) + 'deg) translate(' + inner + 'px, -50%)';
          disc.appendChild(span);
        }

        // ---- qual fatia ganha
        function draw() {
          if (WIN >= 1 && WIN <= N && slices[WIN - 1].code) return WIN - 1;
          var pool = [];
          for (var i = 0; i < N; i++) if (slices[i].code) pool.push(i);
          if (!pool.length) return 0;
          return pool[Math.floor(Math.random() * pool.length)];
        }

        function reduceMotion() {
          return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }

        function spin() {
          if (spinning || spun) return;
          spinning = true;

          var idx = draw();
          lead.code = slices[idx].code;
          lead.label = slices[idx].label || slices[idx].code;

          // o centro da fatia precisa parar sob o ponteiro (topo)
          var center = idx * step + step / 2;
          var jitter = (Math.random() - 0.5) * (step * 0.45);
          rotation += 360 * 6 - center + jitter;

          function finish() {
            spinning = false;
            spun = true;
            var el = q('[data-brl-prize]');
            if (el) el.textContent = lead.label;
            show(2);
            var p = q('[data-brl-phone]');
            if (p) { try { p.focus({ preventScroll: true }); } catch (e) { p.focus(); } }
          }

          if (reduceMotion()) {
            disc.style.transition = 'none';
            disc.style.transform = 'rotate(' + rotation + 'deg)';
            finish();
            return;
          }

          disc.style.transform = 'rotate(' + rotation + 'deg)';
          var done = false;
          var once = function () { if (done) return; done = true; finish(); };
          disc.addEventListener('transitionend', once, { once: true });
          setTimeout(once, 5600);
        }

        // ---- captura
        function send(extra) {
          if (!ENDPOINT) return;
          var payload = {
            email: lead.email,
            telefone: lead.phone,
            cupom: lead.code,
            premio: lead.label,
            origem: 'roleta'
          };
          for (var k in extra) { if (Object.prototype.hasOwnProperty.call(extra, k)) payload[k] = extra[k]; }
          try {
            fetch(ENDPOINT, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              keepalive: true
            }).catch(function () {});
          } catch (e) {}
        }

        function sendToShopify(email) {
          try {
            var fd = new FormData();
            fd.append('form_type', 'customer');
            fd.append('utf8', '✓');
            fd.append('contact[email]', email);
            fd.append('contact[tags]', 'newsletter,roleta');
            fetch('/contact', { method: 'POST', body: fd, headers: { Accept: 'application/json' }, keepalive: true }).catch(function () {});
          } catch (e) {}
        }

        // ---- e-mail libera o giro
        q('[data-brl-email-form]').addEventListener('submit', function (e) {
          e.preventDefault();
          if (spinning || spun) return;
          var input = q('[data-brl-email]');
          var err = q('[data-brl-email-err]');
          var email = (input.value || '').trim();
          if (!/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(email)) {
            err.hidden = false;
            input.focus();
            return;
          }
          err.hidden = true;
          lead.email = email;
          var btn = q('[data-brl-spin]');
          if (btn) { btn.disabled = true; btn.textContent = 'Girando…'; }
          input.disabled = true;
          sendToShopify(email);
          spin();
          send({ etapa: 'email' });
        });

        // ---- WhatsApp libera o cupom
        var phoneInput = q('[data-brl-phone]');
        phoneInput.addEventListener('input', function () {
          var d = (phoneInput.value || '').replace(/\D/g, '').slice(0, 11);
          var out = d;
          if (d.length > 2) out = '(' + d.slice(0, 2) + ') ' + d.slice(2);
          if (d.length > 7) {
            var cut = d.length > 10 ? 7 : 6;
            out = '(' + d.slice(0, 2) + ') ' + d.slice(2, cut) + '-' + d.slice(cut);
          }
          phoneInput.value = out;
        });

        q('[data-brl-phone-form]').addEventListener('submit', function (e) {
          e.preventDefault();
          var err = q('[data-brl-phone-err]');
          var consent = q('[data-brl-consent]');
          var digits = (phoneInput.value || '').replace(/\D/g, '');
          if (digits.length < 10 || digits.length > 11) {
            err.textContent = 'Digite um celular com DDD.';
            err.hidden = false;
            phoneInput.focus();
            return;
          }
          if (!consent.checked) {
            err.textContent = 'Marque a caixinha pra liberar o cupom.';
            err.hidden = false;
            return;
          }
          err.hidden = true;
          lead.phone = '+55' + digits;
          send({ etapa: 'whatsapp', vip: true });
          var codeEl = q('[data-brl-code]');
          if (codeEl) codeEl.textContent = lead.code;
          show(3);
        });

        // ---- copiar cupom
        q('[data-brl-copy]').addEventListener('click', function () {
          var btn = this;
          var ok = function () {
            btn.textContent = 'Copiado ✓';
            btn.classList.add('is-ok');
            var h = q('[data-brl-hint]');
            if (h) h.textContent = 'Cupom copiado! É só colar no carrinho.';
          };
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(lead.code).then(ok, ok);
          } else {
            ok();
          }
        });

        // ---- abrir / fechar
        function open() {
          if (opened) return;
          opened = true;
          try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
          root.hidden = false;
          requestAnimationFrame(function () { root.classList.add('is-open'); });
          document.documentElement.style.overflow = 'hidden';
        }
        function close() {
          root.classList.remove('is-open');
          document.documentElement.style.overflow = '';
          setTimeout(function () { root.hidden = true; }, 260);
        }

        root.querySelectorAll('[data-brl-close]').forEach(function (b) { b.addEventListener('click', close); });
        root.querySelector('.brl-ov').addEventListener('click', function (e) { if (e.target === this) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !root.hidden) close(); });

        var seen = false;
        try { seen = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
        if (!seen) {
          setTimeout(open, DELAY);
          document.addEventListener('mouseout', function (e) {
            if (!opened && !e.relatedTarget && e.clientY <= 0) open();
          });
        }
      })();
    </script>
  {%- endif -%}
{%- endif -%}
