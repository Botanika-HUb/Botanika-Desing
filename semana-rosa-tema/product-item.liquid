{% stylesheet %}
  /* Botanika — card padronizado: CTA verde de compra (igual à PDP), nome curto e alturas iguais */
  .product-item .product__add-cart.morden-style { background: #10c322 !important; border-color: #10c322 !important; color: #fff !important; box-shadow: 0 6px 16px rgba(16,195,34,.25); }
  .product-item .product__add-cart.morden-style:hover { background: #079615 !important; border-color: #079615 !important; color: #fff !important; }
  .swiper-slide > .product-item, .product-item.grid-custom-item { height: 100%; }
  .product-item__wrapper.product-grid { height: 100%; display: flex; flex-direction: column; }
  .product-item__wrapper.product-grid .product-item__information { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; }
  .product-item__wrapper.product-grid .product-item__information > * { max-width: 100%; }
  .product-item__wrapper.product-grid .product-item__name { line-height: 1.3; min-height: 2.6em; display: -webkit-box; }
  .product-item__wrapper.product-grid .product-item__product-form { margin-top: auto; width: 100%; }
  .product-item__wrapper.product-grid review-product { min-height: 20px; }

  /* Tag de lançamento (produto novo ainda sem avaliações) */
  .bk-new { display: inline-flex; align-items: center; min-height: 20px; padding: 2px 9px; border-radius: 999px; background: #eef0fb; color: #323C91; font-size: 11px; font-weight: 800; line-height: 1.2; letter-spacing: .02em; white-space: nowrap; }
  /* Selo de vendidos (dado real do mês, metafield custom.bk_vendidos) */
  .bk-sold { position: absolute; left: 10px; bottom: 10px; z-index: 3; display: inline-flex; align-items: center; padding: 4px 9px; border-radius: 999px; background: rgba(255,255,255,.94); color: #b4361a; font-size: 11px; font-weight: 800; line-height: 1.1; box-shadow: 0 2px 8px rgba(27,37,96,.14); pointer-events: none; white-space: nowrap; }
  /* Favoritos e Comparar fora do site: não existem as páginas /pages/wishlist e /pages/compare */
  .product-item .product-item__button-wishlist,
  button-wishlist, button-compare { display: none !important; }
  /* Pílula de desconto ao lado do preço riscado */
  .bk-cmprow { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .bk-cmprow__pill { display: inline-flex; align-items: center; background: #1a8f3c; color: #fff; font-size: 11px; font-weight: 800; padding: 2px 7px; border-radius: 99px; line-height: 1.2; text-decoration: none; }
  @media (max-width: 749px) {
    .bk-sold { left: 8px; bottom: 8px; font-size: 10px; padding: 3px 7px; }
    .product-item .btrate__w { display: none; }
    .product-item .btrate { gap: 4px; }
    .product-item__wrapper.product-grid .product-item__name { margin-bottom: 3px; }
    .product-item__wrapper.product-grid .product-item__price { margin-top: 4px !important; }
    .product-item__wrapper.product-grid .product__add-cart.morden-style { margin-top: 10px !important; min-height: 44px; }
  }
{% endstylesheet %}
