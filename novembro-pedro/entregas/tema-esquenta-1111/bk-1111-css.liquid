{%- comment -%} Estilos do 11/11 (usado pelo bk-1111). {%- endcomment -%}
<style>
  html.bk-onze-locked,html.bk-onze-locked body{overflow:hidden!important}
  .bk-onze-gate{position:fixed;inset:0;z-index:2147483646;background:#0b0b0f;color:#fff;display:flex;align-items:center;justify-content:center;padding:24px 18px;overflow:auto;font-family:inherit}
  .bk-onze-gate__box{max-width:560px;width:100%;text-align:center}
  .bk-onze-gate__logo{filter:brightness(0) invert(1);width:150px;height:auto;margin:0 auto 22px;display:block}
  .bk-onze-gate__eye{display:inline-block;background:#e3132b;color:#fff;font-weight:800;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;padding:7px 14px;border-radius:99px}
  .bk-onze-gate__h{color:#fff;font-size:clamp(28px,6vw,44px);line-height:1.05;font-weight:800;letter-spacing:-.02em;margin:16px 0 12px}
  .bk-onze-gate__h em{font-style:normal;color:#e3132b}
  .bk-onze-gate__p{color:#d6d6de;font-size:16px;margin:0 0 18px}
  .bk-onze-gate__p b{color:#fff}
  .bk-onze-gate__count{font-size:15px;color:#d6d6de;margin-bottom:20px}
  .bk-onze-gate__count b{display:block;font-size:40px;color:#fff;font-variant-numeric:tabular-nums;letter-spacing:.02em;margin-top:4px}
  .bk-onze-gate__cta{display:block;background:#e3132b;color:#fff!important;text-decoration:none;font-weight:800;font-size:17px;padding:17px 22px;border-radius:99px;box-shadow:0 12px 30px -12px #e3132b}
  .bk-onze-gate__login{display:block;margin-top:14px;color:#d6d6de!important;font-size:14.5px;text-decoration:none;border:1px solid #ffffff33;border-radius:99px;padding:13px 18px}
  .bk-onze-gate__login b{color:#fff;text-decoration:underline}
  .bk-onze-gate__s{color:#b9b9c4;font-size:13.5px;margin:14px 0 0}
  .bk-onze-bar{background:#0b0b0f;color:#fff;font-size:13px;font-weight:600;line-height:1.25;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:4px 12px;padding:8px 14px;text-align:center}
  .bk-onze-bar b{font-weight:800}
  .bk-onze-bar__tag{background:#e3132b;color:#fff;font-weight:800;border-radius:6px;padding:2px 8px}
  .bk-onze-bar__t b{font-variant-numeric:tabular-nums;color:#ff5a6b}
  .bk-onze-bar__cta{background:#e3132b;color:#fff!important;font-weight:800;border-radius:99px;padding:4px 12px;text-decoration:none;font-size:12px}
  @media (max-width:749px){.bk-onze-bar{font-size:12px;gap:2px 10px}}
</style>
{%- if template.name == 'index' -%}
<style>
  .bk-onze-home{background:#0b0b0f;color:#fff;overflow:hidden}
  .bk-onze-home__in{max-width:1320px;margin:0 auto;padding:40px 20px;display:grid;grid-template-columns:1.05fr .95fr;gap:36px;align-items:center}
  .bk-onze-home__eye{display:inline-block;background:#e3132b;color:#fff;font-weight:800;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;padding:7px 13px;border-radius:99px}
  .bk-onze-home__h{color:#fff;font-size:clamp(28px,3.6vw,46px);line-height:1.05;margin:14px 0 18px;font-weight:800;letter-spacing:-.02em}
  .bk-onze-home__h em{font-style:normal;color:#e3132b}
  .bk-onze-home__perks{list-style:none;margin:0 0 20px;padding:0;display:grid;gap:7px;font-size:15px;color:#d6d6de}
  .bk-onze-home__perks b{color:#fff}
  .bk-onze-home__row{display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px}
  .bk-onze-home__cta{background:#e3132b;color:#fff!important;text-decoration:none;font-weight:800;font-size:16px;padding:15px 28px;border-radius:99px;box-shadow:0 10px 26px -10px #e3132b}
  .bk-onze-home__t{font-size:14px;color:#d6d6de}
  .bk-onze-home__t b{color:#ff5a6b;font-variant-numeric:tabular-nums;font-size:16px}
  .bk-onze-home__note{font-size:12.5px;color:#a9a9b6;margin:12px 0 0}
  .bk-onze-home__img img{display:block;width:100%;height:auto;border-radius:22px}
  @media (max-width:749px){
    .bk-onze-home__in{grid-template-columns:1fr;padding:26px 16px 30px;gap:20px;text-align:center}
    .bk-onze-home__img{order:-1}
    .bk-onze-home__row{justify-content:center}
    .bk-onze-home__cta{width:100%;text-align:center}
  }
</style>
{%- endif -%}
{%- if template.name == 'product' -%}
<style>
  .bk-onze-pdp{border:2px solid #e3132b;border-radius:14px;padding:12px 14px;margin:0 0 14px;background:#0b0b0f;color:#fff;font-size:13.5px;line-height:1.4}
  .bk-onze-pdp__h{font-size:14px;margin-bottom:6px}
  .bk-onze-pdp__h b{color:#ff5a6b}
  .bk-onze-pdp__s{font-size:12px;color:#a9a9b6;margin-top:4px}
</style>
{%- endif -%}
