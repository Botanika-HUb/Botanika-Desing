{%- comment -%}
  Esquentômetro (Esquenta 11/11 e Esquenta Botanika Week). Componente <bk-esq-meter>.
  O cliente arrasta "quantos produtos vai levar" (1 a 5+) e o desconto esquenta:
  1–2 un. 8% (frio) · 3–4 un. 10% (morno) · 5+ un. 12% (temperatura máxima).
  Mostra a economia em reais e acende o frete grátis (R$ 249) e o cranberry de brinde (R$ 400).
    data-mode="home": exemplo com um produto de referência e botão para os mais vendidos.
    data-mode="pdp":  usa o preço do produto, muda a quantidade do formulário e adiciona ao carrinho.
  Usado pelo bk-esquenta-1111 (home) e pelo bk-esquenta-pdp (página de produto).
{%- endcomment -%}
<style>
  bk-esq-meter{display:block;--bkm-acc:#2a4bd7;color:#0a1240;font-family:inherit}
  .bkm{position:relative;border-radius:24px;padding:22px 20px 22px;background:linear-gradient(180deg,#eaf0ff,#fff);transition:background .45s,color .45s;overflow:hidden}
  .bkm[data-heat="2"]{--bkm-acc:#ff6a1a;background:linear-gradient(180deg,#fff0e2,#fff)}
  .bkm[data-heat="3"]{--bkm-acc:#fff;color:#fff;background:radial-gradient(120% 80% at 50% 0%,#ff6a1a 0%,#d10f24 55%,#7a0618 100%)}
  .bkm__fl{position:absolute;right:18px;top:20px;display:flex;gap:4px;align-items:flex-end}
  .bkm__fl i{width:7px;border-radius:4px;background:currentColor;opacity:.2;transition:opacity .3s,background .3s}
  .bkm__fl i:nth-child(1){height:10px}.bkm__fl i:nth-child(2){height:16px}.bkm__fl i:nth-child(3){height:22px}
  .bkm[data-heat="1"] .bkm__fl i:nth-child(1){opacity:1;background:#3b5ef0}
  .bkm[data-heat="2"] .bkm__fl i:nth-child(-n+2){opacity:1}.bkm[data-heat="2"] .bkm__fl i:nth-child(1){background:#3b5ef0}.bkm[data-heat="2"] .bkm__fl i:nth-child(2){background:#ff9a1f}
  .bkm[data-heat="3"] .bkm__fl i{opacity:1;background:#fff}
  .bkm__k{font-size:11.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;opacity:.75;padding-right:50px}
  .bkm[data-heat="3"] .bkm__k{color:#ffe2b0;opacity:1}
  .bkm__q{font-size:19px;font-weight:800;line-height:1.15;margin:8px 0 6px}
  .bkm__big{font-weight:900;font-size:112px;line-height:.86;letter-spacing:-.05em;color:var(--bkm-acc);margin:6px 0 4px;transition:color .3s;font-variant-numeric:tabular-nums}
  .bkm__big small{font-size:40px;letter-spacing:-.02em}
  .bkm[data-heat="3"] .bkm__big{text-shadow:0 8px 30px rgba(0,0,0,.35)}
  .bkm__lab{font-size:14.5px;line-height:1.4;opacity:.9}
  .bkm__lab b{font-weight:800}
  .bkm__rng{position:relative;margin:20px 0 4px}
  .bkm__rng input{-webkit-appearance:none;appearance:none;width:100%;height:44px;margin:0;background:transparent;cursor:pointer;--p:0%}
  .bkm__rng input::-webkit-slider-runnable-track{height:12px;border-radius:99px;background:linear-gradient(90deg,#3b5ef0,#ff9a1f 55%,#e3132b) 0 0/var(--p) 100% no-repeat,rgba(10,18,64,.09)}
  .bkm__rng input::-moz-range-track{height:12px;border-radius:99px;background:rgba(10,18,64,.09)}
  .bkm__rng input::-moz-range-progress{height:12px;border-radius:99px;background:linear-gradient(90deg,#3b5ef0,#ff9a1f 55%,#e3132b)}
  .bkm__rng input::-webkit-slider-thumb{-webkit-appearance:none;width:40px;height:40px;margin-top:-14px;border-radius:50%;background:#fff;border:0;box-shadow:0 6px 16px rgba(0,0,0,.28)}
  .bkm__rng input::-moz-range-thumb{width:40px;height:40px;border-radius:50%;background:#fff;border:0;box-shadow:0 6px 16px rgba(0,0,0,.28)}
  .bkm[data-heat="3"] .bkm__rng input::-webkit-slider-runnable-track{background:linear-gradient(90deg,#ffd27a,#fff) 0 0/var(--p) 100% no-repeat,rgba(255,255,255,.25)}
  .bkm__knob{position:absolute;top:2px;width:40px;height:40px;margin-left:-20px;display:grid;place-items:center;font-weight:900;font-size:16px;color:#0a1240;pointer-events:none;transition:left .15s}
  .bkm[data-heat="2"] .bkm__knob{color:#ff6a1a}.bkm[data-heat="3"] .bkm__knob{color:#d10f24}
  .bkm__ticks{display:flex;justify-content:space-between;font-size:12px;font-weight:800;opacity:.7;padding:0 12px}
  .bkm__ticks span{cursor:pointer}
  .bkm__sv{margin:16px 0 12px;font-size:14.5px;line-height:1.4}
  .bkm__sv b{font-weight:900;font-size:21px}
  .bkm__un{display:grid;gap:8px}
  .bkm__u{display:flex;align-items:center;gap:10px;border-radius:14px;padding:10px 12px;font-size:14px;line-height:1.3;border:1.5px dashed currentColor;opacity:.45;transition:opacity .3s}
  .bkm__u.on{opacity:1;border-style:solid}
  .bkm__u i{font-style:normal;font-size:18px;width:26px;text-align:center}
  .bkm__u img{width:26px;height:26px;object-fit:contain}
  .bkm:not([data-heat="3"]) .bkm__u.on{color:#1a8f3c}
  .bkm__cta{display:block;width:100%;margin-top:16px;border:0;cursor:pointer;text-align:center;font:inherit;font-weight:900;font-size:16.5px;padding:16px;border-radius:99px;background:#0a1240;color:#fff!important;text-decoration:none!important;transition:background .3s,color .3s}
  .bkm[data-heat="3"] .bkm__cta{background:#fff;color:#c10f22!important}
  .bkm__nt{margin:10px 0 0;font-size:12px;opacity:.7;text-align:center}
  .bkm--pdp .bkm__rng,.bkm--pdp .bkm__ticks{display:none}
  .bkm__hint{font-size:13px;font-weight:700;opacity:.8;margin:14px 0 8px}
  .bkm__pots{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:0 0 4px}
  .bkm__pot{position:relative;display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 2px 7px;border-radius:14px;border:1.5px dashed rgba(10,18,64,.22);background:rgba(255,255,255,.5);color:inherit;font:inherit;cursor:pointer;transition:background .25s,border-color .25s,transform .15s}
  .bkm__pot:active{transform:scale(.94)}
  .bkm__pot img{width:100%;max-width:44px;height:44px;object-fit:contain;filter:grayscale(1);opacity:.35;transition:filter .25s,opacity .25s,transform .25s}
  .bkm__pot b{font-size:12px;font-weight:900;line-height:1}
  .bkm__pot small{font-size:10.5px;font-weight:800;line-height:1;opacity:.55}
  .bkm__pot.on{border-style:solid;border-color:var(--bkm-acc);background:#fff}
  .bkm__pot.on img{filter:none;opacity:1}
  .bkm__pot.cur{box-shadow:0 0 0 3px var(--bkm-acc),0 10px 22px -10px rgba(0,0,0,.45)}
  .bkm__pot.cur img{transform:scale(1.08)}
  .bkm__pot.st small{opacity:1;color:#e3132b}
  .bkm[data-heat="3"] .bkm__pot{border-color:rgba(255,255,255,.4);background:rgba(255,255,255,.1)}
  .bkm[data-heat="3"] .bkm__pot.on{background:#fff;color:#c10f22;border-color:#fff}
  .bkm[data-heat="3"] .bkm__pot.cur{box-shadow:0 0 0 3px #ffd27a,0 10px 24px -8px rgba(0,0,0,.5)}
  .bkm__pot.on b,.bkm__pot.on small{color:#0a1240}
  .bkm[data-heat="3"] .bkm__pot.on b,.bkm[data-heat="3"] .bkm__pot.on small{color:#c10f22}
  html.bk-esq-pdpm .product-detail__buy-buttons .product-form__buttons{display:none!important}
  @media (prefers-reduced-motion:reduce){.bkm,.bkm__big,.bkm__knob,.bkm__u{transition:none}}
</style>
<script>
(function(){
  if (window.customElements && customElements.get('bk-esq-meter')) return;
  var CRAN = 'https://cdn.shopify.com/s/files/1/0780/7238/1672/files/hf_20260911_150202_d733ca0a-dc7b-4c78-ac5e-cb4780f95dd7.png?v=1789140114&width=80';
  function pct(q){ return q >= 5 ? 12 : q >= 3 ? 10 : 8; }
  function heat(q){ return q >= 5 ? 3 : q >= 3 ? 2 : 1; }
  function money(c){ var a = (c / 100).toFixed(2).split('.'); return 'R$ ' + a[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + a[1]; }
  class BkEsqMeter extends HTMLElement {
    connectedCallback(){
      if (this.__ok) return; this.__ok = true;
      var pdp = this.dataset.mode === 'pdp', self = this;
      this.unit = parseInt(this.dataset.unit, 10) || 9940; this.inst = parseInt(this.dataset.installments, 10) || 3; this.name = this.dataset.name || '';
      var img = this.dataset.img || '';
      if (pdp && !img) { try { var pj = JSON.parse(this.section().querySelector('.productJson').textContent); img = pj.featured_image || ''; } catch (e) {} }
      if (img && img.indexOf('width=') < 0) img += (img.indexOf('?') < 0 ? '?' : '&') + 'width=120';
      var pots = '';
      if (pdp) { for (var k = 1; k <= 5; k++) pots += '<button type="button" class="bkm__pot" role="radio" data-n="' + k + '" aria-label="' + k + (k > 1 ? ' potes' : ' pote') + '">' + (img ? '<img src="' + img + '" alt="">' : '') + '<b>' + k + (k > 1 ? ' potes' : ' pote') + '</b><small>' + pct(k) + '%</small></button>'; }
      this.innerHTML = '<div class="bkm' + (pdp ? ' bkm--pdp' : '') + '" data-heat="1"><div class="bkm__fl" aria-hidden="true"><i></i><i></i><i></i></div>'
        + '<div class="bkm__k" data-k></div><div class="bkm__q">' + (pdp ? 'Quantos potes você vai levar?' : 'Quantos produtos você vai levar?') + '</div>'
        + '<div class="bkm__big" aria-live="polite"><span data-p>8</span><small>% OFF</small></div><div class="bkm__lab" data-lab></div>'
        + '<div class="bkm__rng"><input type="range" min="1" max="5" step="1" value="' + (pdp ? 3 : 1) + '" aria-label="Quantidade"><span class="bkm__knob" data-knob></span></div>'
        + '<div class="bkm__ticks"><span>1</span><span>2</span><span>3</span><span>4</span><span>5+</span></div>'
        + (pdp ? '<div class="bkm__hint">👇 Toque em quantos potes você quer levar</div><div class="bkm__pots" role="radiogroup" aria-label="Quantidade de potes">' + pots + '</div>' : '')
        + '<div class="bkm__sv" data-sv></div>'
        + '<div class="bkm__un"><div class="bkm__u" data-u1><i>🚚</i><span data-u1t></span></div><div class="bkm__u" data-u2><img src="' + CRAN + '" alt=""><span data-u2t></span></div></div>'
        + (pdp ? '<button type="button" class="bkm__cta" data-cta></button>' : '<a class="bkm__cta" href="/collections/mais-vendidos" data-cta>Esquentar meu carrinho →</a>')
        + '<p class="bkm__nt">Vale misturando produtos diferentes. O desconto entra sozinho no carrinho.</p></div>';
      this.box = this.querySelector('.bkm'); this.r = this.querySelector('input');
      this.r.addEventListener('input', function(){ self.render(); });
      this.querySelectorAll('.bkm__ticks span').forEach(function(s, i){ s.addEventListener('click', function(){ self.r.value = i + 1; self.render(); }); });
      this.querySelectorAll('.bkm__pot').forEach(function(b){ b.addEventListener('click', function(){ self.r.value = b.dataset.n; self.render(); }); });
      if (pdp) document.documentElement.classList.add('bk-esq-pdpm');
      if (pdp) {
        this.querySelector('[data-cta]').addEventListener('click', function(){ self.addToCart(); });
        this.watchVariant();
      }
      this.render();
    }
    render(){
      var q = parseInt(this.r.value, 10), p = pct(q), h = heat(q), pdp = this.dataset.mode === 'pdp';
      var total = this.unit * q, save = Math.floor(total * p / 100), price = total - save;
      this.box.setAttribute('data-heat', h);
      this.r.style.setProperty('--p', ((q - 1) / 4 * 100) + '%');
      this.querySelectorAll('.bkm__pot').forEach(function(b){ var n = +b.dataset.n; b.classList.toggle('on', n <= q); b.classList.toggle('cur', n === q); b.classList.toggle('st', n === 3 || n === 5); b.setAttribute('aria-checked', n === q); });
      var knob = this.querySelector('[data-knob]'); knob.textContent = q === 5 && !pdp ? '5+' : q; knob.style.left = 'calc(20px + (100% - 40px) * ' + ((q - 1) / 4) + ')';
      this.querySelector('[data-p]').textContent = p;
      this.querySelector('[data-k]').textContent = 'Esquenta 11/11 · ' + (h === 3 ? 'temperatura máxima' : 'Esquentômetro');
      if (pdp) {
        this.querySelector('[data-lab]').innerHTML = '<b>' + q + (q > 1 ? ' potes' : ' pote') + '</b> por <b>' + money(price) + '</b>' + (q > 1 ? ' · ' + money(Math.floor(price / q)) + ' cada' : '') + ' · ' + this.inst + 'x de ' + money(Math.floor(price / this.inst));
        this.querySelector('[data-sv]').innerHTML = 'Você economiza <b>' + money(save) + '</b>' + (q < 5 ? ' · com ' + (q < 3 ? 3 : 5) + ' potes vai para ' + (q < 3 ? 10 : 12) + '%' : '');
        this.querySelector('[data-cta]').textContent = 'Adicionar ' + q + (q > 1 ? ' potes' : ' pote') + ' ao carrinho';
        this.setQty(q);
      } else {
        this.querySelector('[data-lab]').innerHTML = 'levando <b>' + (q === 5 ? '5 ou mais' : q + (q > 1 ? ' produtos' : ' produto')) + '</b>, misturando o que quiser';
        this.querySelector('[data-sv]').innerHTML = q === 1 ? 'Arraste e veja o desconto <b>esquentar</b> 🔥' : 'Exemplo com ' + q + ' potes de ' + this.name + ': você economiza <b>' + money(save) + '</b>';
      }
      var f = price >= 24900, g = price >= 40000;
      this.querySelector('[data-u1]').classList.toggle('on', f);
      this.querySelector('[data-u2]').classList.toggle('on', g);
      this.querySelector('[data-u1t]').textContent = f ? 'Frete grátis desbloqueado' : (pdp ? 'Faltam ' + money(24900 - price) + ' para o frete grátis' : 'Frete grátis acima de R$ 249');
      this.querySelector('[data-u2t]').textContent = g ? 'Cranberry de brinde desbloqueado 🎁' : (pdp ? 'Faltam ' + money(40000 - price) + ' para o cranberry de brinde' : 'Cranberry de brinde acima de R$ 400');
    }
    section(){ return this.closest('[id^="shopify-section-"]') || document; }
    setQty(q){
      var input = this.section().querySelector('input.quantity-input') || document.querySelector('input.quantity-input');
      if (input && String(input.value) !== String(q)) { input.value = q; input.dispatchEvent(new Event('change', { bubbles: true })); }
    }
    addToCart(){
      this.setQty(parseInt(this.r.value, 10));
      var btn = this.section().querySelector('form[action*="/cart/add"] [type="submit"], form[action*="/cart/add"] button[name="add"]');
      if (btn) btn.click(); else { var f = this.section().querySelector('form[action*="/cart/add"]'); if (f) f.requestSubmit ? f.requestSubmit() : f.submit(); }
    }
    watchVariant(){
      var self = this, s = this.section(), v = s.querySelector('input.product-variant-id'), j = s.querySelector('.productJson');
      if (!v || !j) return; var data; try { data = JSON.parse(j.textContent); } catch (e) { return; }
      var up = function(){ var id = parseInt(v.value, 10), x = data.variants.find(function(y){ return y.id === id; }); if (x && x.price !== self.unit) { self.unit = x.price; self.render(); } };
      new MutationObserver(up).observe(v, { attributes: true, attributeFilter: ['value'] }); v.addEventListener('change', up);
    }
  }
  customElements.define('bk-esq-meter', BkEsqMeter);
})();
</script>
