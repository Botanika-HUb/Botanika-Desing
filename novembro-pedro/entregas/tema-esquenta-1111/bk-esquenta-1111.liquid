{%- comment -%}
  ============================================================
  Esquenta 11/11 (02/11 00h → 10/11 20h, horário de Brasília).
  Renderizado uma vez no <head> (via snippets/botanika-campaign-css).
  Tudo vem em <template> e o script coloca na página só dentro da janela:
    - banner da campanha no topo da home (conceito "quanto mais leva, mais esquenta")
    - o seletor de potes da página de produto troca para 1 pote 8%, 3 potes 10% e 5 potes 12%
      (isso fica no bloco _product-quantity-cards)
    - cranberry de brinde entrando sozinho no carrinho acima de R$ 400
  Fora da janela nada aparece. Para ver antes: abra qualquer página
  com ?esquenta=1 (fica salvo na aba até fechar).
  O desconto em si é da Shopify (escada 8/10/12%, frete > R$ 249 e
  brinde "Compre X ganhe Y"); este arquivo só mostra e adiciona o
  brinde ao carrinho.
  ============================================================
{%- endcomment -%}
{%- liquid
  assign esq_start = 1793588400
  assign esq_end = 1794351600
-%}
{%- if template.name == 'index' -%}
{%- render 'bk-esquenta-css' -%}
<template id="bk-esq-home">
<section class="bkq" aria-label="Esquenta 11/11">
  <div class="bkq__in">
    <div class="bkq__tx">
      <span class="bkq__eye"><span class="bkq__fl" aria-hidden="true"><i></i><i></i><i></i></span>Esquenta 11/11 · 02 a 10/11</span>
      <h2 class="bkq__h">Quanto mais leva, <em>mais esquenta.</em></h2>
      <p class="bkq__p">O desconto sobe junto com o seu carrinho, misturando os produtos que quiser.</p>
    </div>
    <div class="bkq__vis">
      <img class="bkq__prod" src="https://cdn.shopify.com/s/files/1/0780/7238/1672/files/lp1111-linha-recorte.webp?v=1793379234&width=900" alt="Linha Botanika" width="1400" height="566" loading="eager">
      <div class="bkq__lv">
        <div class="bkq__l bkq__l1"><b>8%</b><small>1 unidade</small></div>
        <div class="bkq__l bkq__l2"><b>10%</b><small>3+ unidades</small></div>
        <div class="bkq__l bkq__l3"><b>12%</b><small>5+ unidades</small><span>🔥 temperatura máxima</span></div>
      </div>
    </div>
    <div class="bkq__ft">
      <div class="bkq__perks">
        <div class="bkq__perk"><span class="bkq__ico">🚚</span><span><b>Frete grátis</b> acima de R$&nbsp;249</span></div>
        <div class="bkq__perk"><img src="https://cdn.shopify.com/s/files/1/0780/7238/1672/files/hf_20260911_150202_d733ca0a-dc7b-4c78-ac5e-cb4780f95dd7.png?v=1789140114&width=120" alt="" width="40" height="40"><span><b>Cranberry de brinde</b> acima de R$&nbsp;400<small>2 brindes se você já é cliente</small></span></div>
      </div>
      <div class="bkq__row">
        <a class="bkq__btn" href="/collections/mais-vendidos">Esquentar meu carrinho <span aria-hidden="true">→</span></a>
        <span class="bkq__t">Termina em <b data-bk-esq-count>--</b></span>
      </div>
    </div>
  </div>
</section>
</template>
{%- endif -%}
{%- if template.name == 'product' -%}{%- render 'bk-esquenta-pdp' -%}{%- endif -%}
{%- liquid
  assign esq_want = 1
  if customer and customer.orders_count > 0
    assign esq_want = 2
  endif
-%}

<script>
(function(){
  if (window.__bkEsq) return; window.__bkEsq = true;
  var START = {{ esq_start }} * 1000, END = {{ esq_end }} * 1000;
  var GIFT = 49035962122472, MIN = 40000, WANT = {{ esq_want }};
  try { if (/[?&]esquenta=1\b/.test(location.search)) sessionStorage.setItem('bkEsqPreview', '1'); } catch (e) {}
  function preview(){ try { return sessionStorage.getItem('bkEsqPreview') === '1'; } catch (e) { return false; } }
  function on(){ var n = Date.now(); return (n >= START && n < END) || preview(); }
  if (!on()) return;

  /* banner da home (sem tarja e sem nada acima do produto: decisão do Pedro em 30/10) */
  function pad(n){ return n < 10 ? '0' + n : '' + n; }
  function show(){
    var home = document.getElementById('bk-esq-home'), main = document.getElementById('MainContent');
    if (home && main && !document.querySelector('.bkq')) main.insertBefore(home.content.cloneNode(true), main.firstChild);
  }
  function tick(){
    var s = Math.max(0, Math.floor((END - Date.now()) / 1000));
    var t = Math.floor(s / 86400) + 'd ' + pad(Math.floor(s % 86400 / 3600)) + 'h ' + pad(Math.floor(s % 3600 / 60)) + 'm';
    document.querySelectorAll('[data-bk-esq-count]').forEach(function(el){ el.textContent = t; });
    if (s > 0) setTimeout(tick, 1000);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ show(); tick(); }); else { show(); tick(); }

  /* cranberry de brinde acima de R$ 400 */
  var of = window.fetch.bind(window), busy = false, timer = null;
  try { if (sessionStorage.getItem('bkEsqGiftOff') === '1') return; } catch (e) {}
  function isCart(){ return document.body.classList.contains('template-cart') || /\/cart(\/|$|\?)/.test(location.pathname); }
  function post(url, body){
    if (!isCart()) { body.sections = ['minicart-form']; body.sections_url = location.pathname; }
    return of(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) }).then(function(r){ return r.json(); });
  }
  function refresh(data){
    if (isCart()) { location.reload(); return; }
    var html = data && data.sections && data.sections['minicart-form'];
    var target = document.getElementById('minicart-form');
    if (html && target) {
      var fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('#minicart-form');
      if (fresh) target.innerHTML = fresh.innerHTML;
      var cn = document.querySelector('cart-notification');
      if (cn && typeof cn.cartAction === 'function') { try { cn.cartAction(); } catch (e) {} }
      if (typeof BlsLazyloadImg !== 'undefined' && BlsLazyloadImg.init) BlsLazyloadImg.init();
    }
    of('/cart.json').then(function(r){ return r.json(); }).then(function(cart){
      document.querySelectorAll('.cart-count').forEach(function(el){ el.innerHTML = el.classList.contains('cart-count-drawer') ? '(' + cart.item_count + ')' : cart.item_count; });
      var ht = document.querySelector('header-total-price'); if (ht && ht.updateTotal) ht.updateTotal(cart);
      var fs = document.querySelector('free-ship-progress-bar'); if (fs && fs.init) fs.init(cart.items_subtotal_price);
    }).catch(function(){});
  }
  function toast(msg){
    try { if (window.CartUtils && CartUtils.showToast) { CartUtils.showToast(msg, 'success'); return; } if (typeof showToast === 'function') showToast(msg, 3000, 'modal-success'); } catch (e) {}
  }
  function reconcile(){
    if (busy || !on()) return; busy = true;
    of('/cart.js', { headers: { Accept: 'application/json' } }).then(function(r){ return r.json(); }).then(function(cart){
      var paid = 0, gift = null, giftQty = 0, cranOther = 0;
      (cart.items || []).forEach(function(it){
        var isGift = it.properties && it.properties._brinde;
        if (isGift) { if (!gift) gift = it; giftQty += it.quantity; }
        else { paid += it.final_line_price; if (it.variant_id === GIFT) cranOther += it.quantity; }
      });
      /* se o brinde está no carrinho mas não saiu de graça, a regra da Shopify não está ativa: tira e para */
      if (gift && gift.final_line_price > 0) {
        try { sessionStorage.setItem('bkEsqGiftOff', '1'); } catch (e) {}
        return post('/cart/change.js', { id: gift.key, quantity: 0 }).then(refresh);
      }
      var need = paid >= MIN ? Math.max(0, WANT - cranOther) : 0;
      if (need === giftQty) return;
      var p = gift ? post('/cart/change.js', { id: gift.key, quantity: need })
                   : post('/cart/add.js', { items: [{ id: GIFT, quantity: need, properties: { _brinde: 'Esquenta 11/11' } }] });
      return p.then(function(data){
        if (data && data.status) return; /* sem estoque ou erro: não insiste */
        if (need > giftQty) toast('🎁 Você ganhou Cranberry de brinde!');
        refresh(data);
        setTimeout(reconcile, 900); /* confere se o brinde entrou de graça */
      });
    }).catch(function(){}).then(function(){ busy = false; });
  }
  window.fetch = function(u){
    var p = of.apply(window, arguments);
    try {
      var url = typeof u === 'string' ? u : (u && u.url) || '';
      if (/\/cart\/(add|change|update|clear)/.test(url)) p.then(function(){ clearTimeout(timer); timer = setTimeout(reconcile, 600); }).catch(function(){});
    } catch (e) {}
    return p;
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reconcile); else reconcile();
})();
</script>
