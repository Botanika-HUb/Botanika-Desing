{%- comment -%}
  Esquenta 11/11 e Esquenta Botanika Week: na página de produto, o seletor de potes
  (cartões 2 potes 5% / 3 potes 10%) é trocado pelo Esquentômetro (snippet bk-esq-meter),
  que usa o preço do produto e controla a quantidade do formulário.
  Nada aparece acima da foto do produto. Kits e produtos sem seletor ficam como estão.
{%- endcomment -%}
<script>
(function(){
  var W = [[1793588400000, 1794351600000], [1794452400000, 1795229999000]]; /* Esquenta 11/11 · Esquenta Botanika Week */
  var n = Date.now(), on = W.some(function(w){ return n >= w[0] && n < w[1]; });
  try { if (/[?&]esquenta=1\b/.test(location.search)) sessionStorage.setItem('bkEsqPreview', '1'); if (sessionStorage.getItem('bkEsqPreview') === '1') on = true; } catch (e) {}
  if (!on) return;
  function run(){
    var old = document.querySelector('quantity-discount-cards.qty2');
    if (!old || old.querySelectorAll('.qty2__tier').length < 2) return;
    var m = document.createElement('bk-esq-meter');
    m.dataset.mode = 'pdp'; m.dataset.unit = old.dataset.unitPrice; m.dataset.installments = old.dataset.installments || '3';
    var sp = old.querySelector('.qty2__sp');
    if (sp) old.parentNode.insertBefore(sp, old);
    old.parentNode.replaceChild(m, old);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
})();
</script>
