  .bkq__perk{display:flex;align-items:center;gap:10px;background:#ffffff12;border:1px solid #ffffff22;border-radius:14px;padding:9px 14px 9px 10px;font-size:14px;line-height:1.3;color:#dfe4ff}
  .bkq__perk b{color:#fff}.bkq__perk small{display:block;font-size:12px;opacity:.8}
  .bkq__perk img{width:34px;height:34px;object-fit:contain}.bkq__ico{font-size:22px;width:34px;text-align:center}
  .bkq__row{display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px}
  .bkq__btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(90deg,#ff6a1a,#e3132b);color:#fff!important;text-decoration:none!important;font-weight:900;font-size:16.5px;padding:16px 28px;border-radius:99px;box-shadow:0 14px 30px -12px #e3132b}
