{%- comment -%} Estilos do banner do Esquenta 11/11 na home (usado pelo bk-esquenta-1111). {%- endcomment -%}
<style>
  .bkq{padding:12px 16px 6px}
  .bkq__in{max-width:1320px;margin:0 auto;border-radius:26px;overflow:hidden;color:#fff;position:relative;display:grid;grid-template-columns:1.05fr .95fr;grid-template-areas:"tx vis" "ft vis";column-gap:36px;align-items:center;padding:44px 50px;
    background:radial-gradient(110% 120% at 100% 100%,#3d0c22 0%,rgba(61,12,34,0) 55%),linear-gradient(135deg,#0a1240 0%,#0f1d63 60%,#1b145a 100%)}
  .bkq__tx{grid-area:tx}.bkq__vis{grid-area:vis}.bkq__ft{grid-area:ft}
  .bkq__eye{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#ffb02e}
  .bkq__fl{display:inline-flex;gap:3px;align-items:flex-end;height:14px}.bkq__fl i{width:4px;border-radius:2px}
  .bkq__fl i:nth-child(1){height:5px;background:#3b5ef0}.bkq__fl i:nth-child(2){height:9px;background:#ff9a1f}.bkq__fl i:nth-child(3){height:14px;background:#ff3b4a}
  .bkq__h{margin:12px 0 10px;color:#fff!important;font-size:clamp(34px,4.6vw,62px);line-height:.98;font-weight:900;letter-spacing:-.03em}
  .bkq__h em{font-style:normal;background:linear-gradient(90deg,#ffb02e,#ff6a1a 45%,#ff3b4a);-webkit-background-clip:text;background-clip:text;color:transparent;display:inline-block}
  .bkq__p{margin:0 0 22px;color:#c9d0f3;font-size:16.5px;line-height:1.45;max-width:32em}
  .bkq__vis{position:relative;padding-top:8px}
  .bkq__prod{display:block;width:100%;height:auto;position:relative;z-index:1;margin-bottom:-8px;filter:drop-shadow(0 16px 16px rgba(0,0,0,.45))}
  .bkq__lv{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;align-items:end}
  .bkq__l{border-radius:14px 14px 10px 10px;padding:12px 8px;text-align:center}
  .bkq__l b{display:block;font-size:34px;font-weight:900;line-height:1;letter-spacing:-.02em}
  .bkq__l small{display:block;font-size:12px;opacity:.92;margin-top:4px}
  .bkq__l span{display:block;font-size:10.5px;font-weight:800;margin-top:6px;color:#ffe2b0}
  .bkq__l1{min-height:76px;background:linear-gradient(180deg,#3b5ef0,#2a3fc0)}
  .bkq__l2{min-height:92px;background:linear-gradient(180deg,#ffab2e,#ff7a1a)}
  .bkq__l3{min-height:118px;background:linear-gradient(180deg,#ff4a3a,#d10f24);box-shadow:0 0 0 3px #ffffff2e,0 16px 34px -12px #e3132b}
