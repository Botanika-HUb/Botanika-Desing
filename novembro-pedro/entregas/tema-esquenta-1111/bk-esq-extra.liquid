{%- comment -%}
  Esquenta 11/11 e Esquenta Botanika Week: o site inteiro entra no "modo Esquenta" (classe bk-esq no <html>).
    - tarja do topo própria: termômetro do carrinho + contagem regressiva (substitui as mensagens de sempre)
    - linha de calor embaixo do cabeçalho, que enche e esquenta conforme o carrinho
    - home: banner de lançamentos sai; Mais Vendidos e Lançamentos viram blocos noturnos com títulos da campanha
    - cards: botão em brasa e o preço "levando 5" calculado do produto
    - coleções: banner coberto pela noite do Esquenta com a escada 8/10/12%
    - carrinho: faixa de calor 8% / 10% / 12% com quanto falta pra próxima
  Só aparece nas janelas da campanha ou na prévia com ?esquenta=1. Usado pelo bk-esquenta-1111.
{%- endcomment -%}
<script>
(function(){
  var W = [[1793588400000, 1794351600000], [1794452400000, 1795229999000]]; /* Esquenta 11/11 · Esquenta Botanika Week */
  var n = Date.now(), w = W.filter(function(x){ return n >= x[0] && n < x[1]; })[0];
  try { if (/[?&]esquenta=1\b/.test(location.search)) sessionStorage.setItem('bkEsqPreview', '1'); if (!w && sessionStorage.getItem('bkEsqPreview') === '1') w = W[0]; } catch (e) {}
  if (w) { document.documentElement.classList.add('bk-esq'); window.__bkEsqEnd = w[1]; }
})();
</script>
<style>
  html.bk-esq{--bk-n1:#070a33;--bk-n2:#0f1d63;--bk-em:#3d0c22;--bk-fire:linear-gradient(90deg,#ff9a1f,#ff6a1a 40%,#e3132b)}
  /* tarja do topo */
  html.bk-esq .ttb{background:var(--bk-n1)!important;background-image:none!important}
  html.bk-esq .ttb__inner,html.bk-esq .ttb__bar{display:none!important}
  .bkbar{max-width:1320px;margin:0 auto;height:38px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;color:#fff;font-size:13px;font-weight:600;white-space:nowrap}
  .bkbar__k{font-weight:900;letter-spacing:.14em;font-size:11.5px;background:var(--bk-fire);-webkit-background-clip:text;background-clip:text;color:transparent}
  .bkbar b{color:#ffb02e;font-weight:900}
  .bkbar__t{font-variant-numeric:tabular-nums;opacity:.85}
  @media (max-width:749px){.bkbar{height:36px;font-size:12px;justify-content:center;gap:8px}.bkbar__k,.bkbar__t{display:none}}
  /* linha de calor do cabeçalho */
  html.bk-esq header.header{position:relative}
  .bkline{position:absolute;left:0;right:0;bottom:-1px;height:3px;background:rgba(10,18,64,.08);z-index:5;pointer-events:none}
  .bkline i{display:block;height:100%;width:6%;background:#3b5ef0;transition:width .7s cubic-bezier(.22,.61,.36,1),background .5s}
  .bkline[data-heat="1"] i{width:33%;background:linear-gradient(90deg,#3b5ef0,#6d8bff)}
  .bkline[data-heat="2"] i{width:66%;background:linear-gradient(90deg,#3b5ef0,#ff9a1f)}
  .bkline[data-heat="3"] i{width:100%;background:linear-gradient(90deg,#3b5ef0,#ff9a1f 50%,#e3132b);box-shadow:0 0 12px #ff3b2a}
  /* home */
  html.bk-esq [id*="__slideshow_"]{display:none!important}
  html.bk-esq .bknight{background:radial-gradient(80% 60% at 100% 100%,var(--bk-em) 0%,rgba(61,12,34,0) 60%),linear-gradient(160deg,var(--bk-n1) 0%,var(--bk-n2) 100%)!important;color:#fff}
  html.bk-esq .bknight > *{background:transparent!important}
  html.bk-esq .bknight .section__header-heading,html.bk-esq .bknight h2{color:#fff!important}
  html.bk-esq .bknight .section__header-des{color:#c9d0f3!important}
  html.bk-esq .bknight .product-item__wrapper{background:#fff;border-radius:20px;padding:8px 8px 14px;box-shadow:0 20px 40px -24px rgba(0,0,0,.7)}
  .bkeye{display:block;margin:0 0 8px;font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;background:var(--bk-fire);-webkit-background-clip:text;background-clip:text;color:transparent}
  html.bk-esq .bknight-pad{padding-top:56px!important;padding-bottom:40px!important}
  html.bk-esq .bknight-tail{padding-bottom:48px!important}
  html.bk-esq .bknight-tail a{background:#fff!important;color:#0a1240!important;border-color:#fff!important}
  /* cards */
  html.bk-esq .product__add-cart.morden-style{background:var(--bk-fire)!important;border-color:transparent!important;color:#fff!important;box-shadow:0 10px 22px -12px #e3132b}
  html.bk-esq .product__add-cart.morden-style *{color:#fff!important}
  .bkc5{display:flex;align-items:center;justify-content:center;gap:5px;margin:8px auto 0;padding:5px 10px;width:max-content;max-width:100%;border-radius:99px;background:#fff1ea;color:#c4321a;font-size:12px;font-weight:800;line-height:1.2}
  .bkc5 b{font-weight:900}
  @media (max-width:749px){.bkc5{font-size:11.5px;padding:5px 8px;white-space:nowrap}}
  /* coleções */
  html.bk-esq .sec__page-heading{position:relative}
  html.bk-esq .sec__page-heading::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(70% 90% at 100% 100%,rgba(209,15,36,.55) 0%,rgba(209,15,36,0) 60%),linear-gradient(160deg,rgba(7,10,51,.93) 0%,rgba(15,29,99,.88) 100%)}
  html.bk-esq .sec__page-heading .heading-content{position:relative;z-index:2}
  .bkcolv{display:flex;justify-content:center;gap:6px;margin-top:12px;flex-wrap:wrap}
  .bkcolv span{padding:4px 11px;border-radius:99px;font-size:12.5px;font-weight:800;color:#fff}
  .bkcolv span:nth-child(1){background:#3b5ef0}.bkcolv span:nth-child(2){background:#ff8a1a}.bkcolv span:nth-child(3){background:#e3132b}
  /* carrinho */
  .bkesc{margin:0 0 14px;padding:12px 14px;border-radius:16px;background:linear-gradient(180deg,#eaf0ff,#fff);border:1px solid #e1e6f7;color:#0a1240;transition:background .4s,color .4s}
  .bkesc[data-heat="2"]{background:linear-gradient(180deg,#fff0e2,#fff);border-color:#ffd9bf}
  .bkesc[data-heat="3"]{background:radial-gradient(120% 120% at 50% 0%,#ff6a1a 0%,#d10f24 60%,#7a0618 100%);border-color:transparent;color:#fff}
  .bkesc__t{font-size:13.5px;line-height:1.35;margin:0 0 9px}
  .bkesc__t b{font-weight:900}
  .bkesc__bar,.bkesc__l{display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px}
  .bkesc__s{height:8px;border-radius:99px;background:rgba(10,18,64,.1);transition:background .4s}
  .bkesc[data-heat="3"] .bkesc__s{background:rgba(255,255,255,.28)}
  .bkesc__s.on:nth-child(1){background:#3b5ef0}.bkesc__s.on:nth-child(2){background:#ff9a1f}.bkesc__s.on:nth-child(3){background:#fff}
  .bkesc__l{margin-top:5px;font-size:11px;font-weight:800;opacity:.75}
  .minicart__wrapper .bkesc{margin:12px 20px 0}
</style>
<script>
(function(){
  if (window.__bkEsqX || !document.documentElement.classList.contains('bk-esq')) return; window.__bkEsqX = true;
  var END = window.__bkEsqEnd, units = null; /* null até ler o carrinho */
  function pct(q){ return q >= 5 ? 12 : q >= 3 ? 10 : 8; }
  function heat(q){ return q >= 5 ? 3 : q >= 3 ? 2 : 1; }
  function next(q){ return q >= 5 ? null : q >= 3 ? { need: 5 - q, p: 12 } : { need: 3 - q, p: 10 }; }
  function plural(k){ return k + (k > 1 ? ' produtos' : ' produto'); }
  function money(c){ var a = (c / 100).toFixed(2).split('.'); return 'R$ ' + a[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + a[1]; }
  function pad(x){ return x < 10 ? '0' + x : '' + x; }

  /* tarja do topo */
  var bar = null;
  function topbar(){
    if (!bar) {
      var root = document.querySelector('[data-ttb]'); if (!root) return;
      bar = document.createElement('div'); bar.className = 'bkbar';
      bar.innerHTML = '<span class="bkbar__k">🔥 ESQUENTA 11/11</span><span data-m></span><span class="bkbar__t" data-c></span>';
      root.appendChild(bar); tick();
    }
    if (units === null) return;
    var x = next(units);
    bar.querySelector('[data-m]').innerHTML = !units ? '🔥 Quanto mais leva, <b>mais esquenta</b>: até 12% OFF'
      : !x ? '🔥 Seu carrinho: <b>12% OFF</b> · temperatura máxima'
      : '🔥 Seu carrinho: <b>' + pct(units) + '% OFF</b> · +' + x.need + ' e vai pra ' + x.p + '%';
  }
  function tick(){
    var s = Math.max(0, Math.floor((END - Date.now()) / 1000)), c = bar && bar.querySelector('[data-c]');
    if (c) c.textContent = 'termina em ' + Math.floor(s / 86400) + 'd ' + pad(Math.floor(s % 86400 / 3600)) + 'h ' + pad(Math.floor(s % 3600 / 60)) + 'm';
    if (s > 0) setTimeout(tick, 30000);
  }

  /* linha de calor embaixo do cabeçalho */
  function line(){
    var h = document.querySelector('header.header'); if (!h) return;
    var l = h.querySelector(':scope > .bkline');
    if (!l) { l = document.createElement('span'); l.className = 'bkline'; l.innerHTML = '<i></i>'; h.appendChild(l); }
    l.setAttribute('data-heat', units ? heat(units) : 0);
  }

  /* home: blocos noturnos */
  function night(){
    [['featured_collection_TCP844', 'Os que mais esquentam o carrinho', 'Leve 3 e já ganha 10%. Leve 5 e chega a 12%. Vale misturando.'],
     ['featured_collection_Pd7APa', 'Novidades pra esquentar', 'Entram na conta do Esquenta como qualquer outro produto.']].forEach(function(s){
      var sec = document.querySelector('[id*="__' + s[0] + '"]'); if (!sec || sec.classList.contains('bknight')) return;
      sec.classList.add('bknight'); if (sec.firstElementChild) sec.firstElementChild.classList.add('bknight-pad');
      var h = sec.querySelector('.section__header-heading'), d = sec.querySelector('.section__header-des');
      if (h) { h.textContent = s[1]; h.insertAdjacentHTML('beforebegin', '<span class="bkeye">Esquenta 11/11</span>'); }
      if (d) d.textContent = s[2];
      var tail = sec.nextElementSibling;
      if (tail && /mv_ver_todos/.test(tail.id)) { tail.classList.add('bknight', 'bknight-tail'); }
    });
  }

  /* cards: preço levando 5 */
  function cards(){
    document.querySelectorAll('.product-item:not([data-bkc])').forEach(function(c){
      var cash = c.querySelector('.installment-price__cash'); if (!cash) return;
      c.setAttribute('data-bkc', '1');
      var m = cash.textContent.match(/R\$\s*([\d.]+),(\d{2})/); if (!m) return;
      var unit = parseInt(m[1].replace(/\./g, '') + m[2], 10), each = unit - Math.floor(unit * 12 / 100);
      var el = document.createElement('div'); el.className = 'bkc5';
      el.innerHTML = '🔥 5 un.: <b>' + money(each) + '</b> cada';
      var price = c.querySelector('.product-item__price'); (price || cash).insertAdjacentElement('afterend', el);
    });
  }

  /* coleções */
  function col(){
    var hc = document.querySelector('.sec__page-heading .heading-content'); if (!hc || hc.querySelector('.bkcolv')) return;
    hc.insertAdjacentHTML('afterbegin', '<span class="bkeye">Esquenta 11/11 · quanto mais leva, mais esquenta</span>');
    hc.insertAdjacentHTML('beforeend', '<div class="bkcolv"><span>1 un. 8%</span><span>3 un. 10%</span><span>5+ un. 12%</span></div>');
  }

  /* carrinho */
  function cartHTML(){
    var x = next(units), h = heat(units);
    var t = !units ? 'Esquenta 11/11: leve mais e o desconto <b>esquenta</b> 🔥'
      : !x ? '🔥 <b>Temperatura máxima: 12% OFF</b> no seu carrinho'
      : 'Seu carrinho está em <b>' + pct(units) + '% OFF</b>. Mais <b>' + plural(x.need) + '</b> e vai pra <b>' + x.p + '%</b>';
    return '<p class="bkesc__t">' + t + '</p><div class="bkesc__bar"><i class="bkesc__s' + (units ? ' on' : '') + '"></i><i class="bkesc__s' + (h >= 2 ? ' on' : '') + '"></i><i class="bkesc__s' + (h >= 3 ? ' on' : '') + '"></i></div>'
      + '<div class="bkesc__l"><span>1 un. · 8%</span><span>3 un. · 10%</span><span>5+ un. · 12%</span></div>';
  }
  function cart(){
    if (units === null) return;
    var spots = [], drawer = document.querySelector('.minicart__wrapper free-ship-progress-bar');
    if (drawer) spots.push(drawer);
    var page = document.querySelector('cart-items .bgc') || document.querySelector('cart-items');
    if (page && document.body.classList.contains('template-cart')) spots.push(page);
    spots.forEach(function(s){
      var box = s.tagName === 'CART-ITEMS' ? s.querySelector(':scope > .bkesc') : (s.previousElementSibling && s.previousElementSibling.classList.contains('bkesc') ? s.previousElementSibling : null);
      if (!box) { box = document.createElement('div'); box.className = 'bkesc'; if (s.tagName === 'CART-ITEMS') s.insertBefore(box, s.firstChild); else s.parentNode.insertBefore(box, s); }
      var html = cartHTML(); if (box.__h === html) return; box.__h = html;
      box.setAttribute('data-heat', units ? heat(units) : 1);
      box.innerHTML = html;
    });
  }

  function paint(){ topbar(); line(); cart(); }
  function load(){
    return fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function(r){ return r.json(); }).then(function(c){
      units = (c.items || []).reduce(function(a, it){ return a + (it.properties && it.properties._brinde ? 0 : it.quantity); }, 0);
      paint();
    }).catch(function(){});
  }
  var of = window.fetch, t1 = null;
  window.fetch = function(u){
    var p = of.apply(this, arguments);
    try { var url = typeof u === 'string' ? u : (u && u.url) || ''; if (/\/cart\/(add|change|update|clear)/.test(url)) p.then(function(){ clearTimeout(t1); t1 = setTimeout(load, 300); }).catch(function(){}); } catch (e) {}
    return p;
  };
  function boot(){
    topbar(); line(); night(); col(); cards(); load();
    var t2 = null;
    new MutationObserver(function(){ clearTimeout(t2); t2 = setTimeout(function(){ cards(); cart(); }, 250); }).observe(document.body, { childList: true, subtree: true });
    document.addEventListener('visibilitychange', function(){ if (!document.hidden) load(); });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
