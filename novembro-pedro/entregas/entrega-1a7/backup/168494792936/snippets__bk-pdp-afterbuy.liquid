{%- comment -%}
  Abaixo do botão Comprar: linha do tempo com a estimativa de entrega + formas de pagamento.
  Params (todos opcionais):
    handles   — só nestes produtos (separados por vírgula). Vazio = todos.
    ship      — dias úteis até o envio (padrão 1)
    min, max  — faixa de entrega em dias corridos contados a partir do ENVIO (padrão 5 e 7, definido pela Botanika)
  Pagamento: bandeiras habilitadas na Shopify (fallback: as usadas nos pedidos) + Pix.
{%- endcomment -%}
{%- liquid
  assign ok = true
  if handles != blank
    assign ok = false
    assign hl = handles | split: ','
    for h in hl
      assign hs = h | strip
      if hs == product.handle
        assign ok = true
      endif
    endfor
  endif
  assign d_ship = ship | default: 1
  assign d_min = min | default: 5
  assign d_max = max | default: 7
-%}
{%- if ok -%}
  <div class="bkab" data-bkab data-ship="{{ d_ship }}" data-min="{{ d_min }}" data-max="{{ d_max }}">
    <ol class="bkab__tl">
      <li class="bkab__st">
        <span class="bkab__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.2 10.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 7H6"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg></span>
        <b data-bkab-d="0">Hoje</b><small>Pedido feito</small>
      </li>
      <li class="bkab__st">
        <span class="bkab__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h11v10H2zM13 9h4.5l3.5 3.5V16h-8"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg></span>
        <b data-bkab-d="ship">{{ d_ship }} dia útil</b><small>Enviado</small>
      </li>
      <li class="bkab__st">
        <span class="bkab__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8L12 3.5 20.5 8v8L12 20.5 3.5 16z"/><path d="M3.5 8L12 12.5 20.5 8M12 12.5v8"/></svg></span>
        <b data-bkab-d="range">{{ d_min }} a {{ d_max }} dias após o envio</b><small>Entregue 🇧🇷</small>
      </li>
    </ol>
    <div class="bkab__pay">
      <span class="bkab__pt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Pagamento 100% seguro</span>
      <div class="bkab__cards">
        <span class="bkab__pix" title="Pix" aria-label="Pix"><svg viewBox="0 0 38 24" aria-hidden="true"><rect width="38" height="24" rx="3" fill="#fff"/><g transform="translate(5 5) scale(.58)" fill="#32BCAD"><path d="M18.9 18.4a3.4 3.4 0 0 1-2.4-1l-3.5-3.5a.7.7 0 0 0-.9 0l-3.5 3.5a3.4 3.4 0 0 1-2.4 1h-.7l4.4 4.4a3.5 3.5 0 0 0 5 0l4.5-4.4z"/><path d="M6.2 7.4a3.4 3.4 0 0 1 2.4 1l3.5 3.5c.3.3.7.3.9 0l3.5-3.5a3.4 3.4 0 0 1 2.4-1h.4L14.8 3a3.5 3.5 0 0 0-5 0L5.4 7.4z"/><path d="M22.8 10.4l-2.6-2.6h-1.3a2.4 2.4 0 0 0-1.7.7l-3.5 3.5a1.6 1.6 0 0 1-2.3 0L7.9 8.5a2.4 2.4 0 0 0-1.7-.7H4.6L2 10.4a3.5 3.5 0 0 0 0 5l2.6 2.6h1.6a2.4 2.4 0 0 0 1.7-.7l3.5-3.5a1.7 1.7 0 0 1 2.3 0l3.5 3.5a2.4 2.4 0 0 0 1.7.7h1.3l2.6-2.6a3.5 3.5 0 0 0 0-5z"/></g><text x="23" y="16" font-family="Arial,sans-serif" font-size="8.5" font-weight="700" fill="#555">pix</text></svg></span>
        {%- assign pts = shop.enabled_payment_types -%}
        {%- if pts.size == 0 -%}{%- assign pts = 'visa,master,elo' | split: ',' -%}{%- endif -%}
        {%- for t in pts -%}{{ t | payment_type_svg_tag: class: 'bkab__card' }}{%- endfor -%}
      </div>
    </div>
  </div>
  <style>
    .product-detail__buy-buttons.button-trigger__sticky{margin-top:22px}
    .bkab{margin:30px 0 26px;padding:24px 0 24px;background:transparent;border-top:1px solid #eceef5;border-bottom:1px solid #eceef5}
    .bkab__tl{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);position:relative}
    .bkab__tl::before,.bkab__tl::after{content:"";position:absolute;top:17px;left:16.66%;right:16.66%;height:2px;background:#dfe2ee}
    .bkab__tl::after{background:#232b66;transform-origin:left;transform:scaleX(var(--bkab-s,1));transition:transform 1.4s cubic-bezier(.2,.7,.2,1)}
    .bkab.is-js .bkab__tl::after{--bkab-s:0}
    .bkab.is-js.is-in .bkab__tl::after{--bkab-s:1}
    .bkab__st{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:2px;z-index:1}
    .bkab__ic{width:36px;height:36px;border-radius:50%;background:#232b66;color:#fff;display:flex;align-items:center;justify-content:center;margin-bottom:6px;box-shadow:0 0 0 4px #fff}
    .bkab__ic svg{width:18px;height:18px}
    .bkab__st b{font-size:14px;color:#1b2150;line-height:1.2}
    .bkab__st small{font-size:12.5px;color:#5b6183;line-height:1.3}
    .bkab__pay{display:flex;flex-direction:column;align-items:center;gap:8px;margin-top:14px;padding-top:4px}
    .bkab__pt{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:#1b2150}
    .bkab__pt svg{width:15px;height:15px}
    .bkab__cards{display:flex;flex-wrap:wrap;justify-content:center;gap:6px}
    .bkab__cards svg,.bkab__card{width:38px;height:24px;display:block;border-radius:3px;box-shadow:0 0 0 1px #e3e6f1}
  </style>
  <script>
    (function () {
      var el = document.currentScript && document.currentScript.parentNode.querySelector('[data-bkab]');
      if (!el || el.dataset.ready) return;
      el.dataset.ready = '1';
      var M = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
      function add(d, n) { var x = new Date(d); while (n > 0) { x.setDate(x.getDate() + 1); if (x.getDay() !== 0 && x.getDay() !== 6) n--; } return x; }
      function cal(d, n) { var x = new Date(d); x.setDate(x.getDate() + n); return x; }
      function f(d) { return d.getDate() + ' ' + M[d.getMonth()]; }
      var now = new Date();
      var ship = add(now, +el.dataset.ship || 1), a = cal(ship, +el.dataset.min || 5), b = cal(ship, +el.dataset.max || 7);
      var r = a.getMonth() === b.getMonth() ? a.getDate() + '–' + f(b) : f(a) + ' – ' + f(b);
      el.querySelector('[data-bkab-d="0"]').textContent = 'Hoje, ' + f(now);
      el.querySelector('[data-bkab-d="ship"]').textContent = f(ship);
      el.querySelector('[data-bkab-d="range"]').textContent = r;
      if ('IntersectionObserver' in window && !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) {
        el.classList.add('is-js');
        var io = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { el.classList.add('is-in'); io.disconnect(); } }, { threshold: 0.5 });
        io.observe(el);
      }
    })();
  </script>
{%- endif -%}
