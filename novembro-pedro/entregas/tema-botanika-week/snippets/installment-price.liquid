{% comment %}
  Renders installment price highlight.
  - 3x sem juros

  @param price {number} unit price in cents
  @param scope {string} 'detail' | 'item' | 'sticky'

  Botanika Week (21–26/11): imprime também a versão com 10% (.ip-bf). Ela só aparece quando
  o <html> tem a classe bk-bf (janela da Week ou preview); fora disso fica a versão normal (.ip-std).
  10% = arredondado para baixo, igual ao checkout (R$ 99,40 → R$ 89,46).
{% endcomment %}
{%- liquid
  assign installments_free = 3
  assign per_free = price | divided_by: installments_free
  assign size_class = scope | default: 'item'
  assign bf_off = price | times: 10 | divided_by: 100
  assign bf_price = price | minus: bf_off
  assign bf_per = bf_price | divided_by: installments_free
-%}
{%- if price and price > 0 -%}
  <div class="installment-price ip-std installment-price--{{ size_class }}">
    {%- if size_class == 'item' -%}
      <span class="installment-price__parc primary-color">{{ installments_free }}x de {{ per_free | money }}</span>
      <span class="installment-price__tag">sem juros</span>
      <span class="installment-price__cash">ou {{ price | money }} à vista</span>
    {%- else -%}
      <span class="installment-price__parc primary-color">{{ installments_free }}x de {{ per_free | money }} <span class="installment-price__tag">sem juros</span></span>
      <span class="installment-price__cash">ou {{ price | money }} à vista</span>
    {%- endif -%}
  </div>
  <div class="installment-price ip-bf installment-price--{{ size_class }}">
    {%- if size_class == 'item' -%}
      <span class="ip-bf__old"><s>{{ installments_free }}x {{ per_free | money }}</s> <span class="ip-bf__off">-10%</span></span>
      <span class="installment-price__parc primary-color">{{ installments_free }}x de {{ bf_per | money }}</span>
      <span class="installment-price__tag">sem juros</span>
      <span class="installment-price__cash">ou {{ bf_price | money }} à vista</span>
    {%- elsif size_class == 'detail' -%}
      <span class="ip-bf__old"><s>{{ installments_free }}x {{ per_free | money }}</s> <span class="ip-bf__off">🔥 -10% Botanika Week</span></span>
      <span class="installment-price__parc primary-color">{{ installments_free }}x de {{ bf_per | money }} <span class="installment-price__tag">sem juros</span></span>
      <span class="installment-price__cash">ou <b>{{ bf_price | money }}</b> à vista na Week <s>{{ price | money }}</s></span>
    {%- else -%}
      <span class="installment-price__parc primary-color">{{ installments_free }}x de {{ bf_per | money }} <span class="installment-price__tag">sem juros</span></span>
      <span class="installment-price__cash">ou {{ bf_price | money }} à vista <span class="ip-bf__off">-10%</span></span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .installment-price {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    gap: 1px;
  }
  .installment-price__parc {
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .installment-price__tag {
    font-size: 0.75em;
    font-weight: 600;
    background: #e8f5d0;
    color: #4a7c20;
    border-radius: 4px;
    padding: 1px 5px;
    vertical-align: middle;
    margin-left: 3px;
  }
  .installment-price__cash {
    color: var(--color-text);
    opacity: 0.65;
  }
  .installment-price--item { align-items: center; gap: 3px; }
  .installment-price--item .installment-price__parc { font-size: 1.65rem; white-space: nowrap; color: #323C91; }
  .installment-price--item .installment-price__tag { margin-left: 0; font-size: 1.05rem; line-height: 1.3; padding: 1px 8px; border-radius: 99px; background: #eaf6ee; color: #1a8f3c; white-space: nowrap; }
  .installment-price--item .installment-price__cash { font-size: 1.2rem; white-space: nowrap; }
  /* Sticky */
  .sticky__installment { flex: 0 0 auto; }
  .installment-price--sticky { white-space: nowrap; }
  .installment-price--sticky .installment-price__parc { font-size: 1.5rem; }
  .installment-price--sticky .installment-price__cash { font-size: 1.15rem; }
  /* Detail (PDP) */
  .installment-price--detail .installment-price__parc { font-size: 2.8rem; }
  .installment-price--detail .installment-price__cash { font-size: 1.5rem; }
  /* Campanha: troca a versão normal pela com 10% */
  .installment-price.ip-bf { display: none; }
  html.bk-bf .installment-price.ip-std { display: none; }
  html.bk-bf .installment-price.ip-bf { display: flex; }
  .ip-bf__old { font-size: 1.25rem; color: #8a8a96; font-weight: 600; white-space: nowrap; }
  .ip-bf__old s { color: #8a8a96; }
  .ip-bf__off { display: inline-block; background: #e3132b; color: #fff; font-weight: 800; font-size: 1.05rem; line-height: 1.3; border-radius: 6px; padding: 1px 6px; margin-left: 4px; vertical-align: middle; }
  .installment-price--detail.ip-bf .ip-bf__old { font-size: 1.5rem; margin-bottom: 4px; }
  .installment-price--detail.ip-bf .ip-bf__off { font-size: 1.3rem; padding: 2px 8px; }
  .installment-price--detail.ip-bf .installment-price__parc { font-size: 3.2rem; color: #e3132b !important; }
  .installment-price--detail.ip-bf .installment-price__cash { opacity: 1; color: #141418; margin-top: 3px; }
  .installment-price--detail.ip-bf .installment-price__cash b { color: #e3132b; }
  .installment-price--detail.ip-bf .installment-price__cash s { color: #8a8a96; font-size: .9em; margin-left: 4px; }
  .installment-price--item.ip-bf .installment-price__parc { color: #e3132b; }
  .installment-price--item.ip-bf .ip-bf__old { font-size: 1.15rem; }
  .installment-price--item.ip-bf .ip-bf__off { font-size: .95rem; }
  .installment-price--sticky.ip-bf .installment-price__parc { color: #e3132b; }
  .installment-price--sticky.ip-bf .ip-bf__off { font-size: .9rem; padding: 0 5px; }
{% endstylesheet %}
