{%- comment -%}
  ============================================================
  11/11 da Botanika (horário de Brasília). Renderizado uma vez no <head>
  (via snippets/botanika-campaign-css), igual ao bk-esquenta-1111.
    10/11 20h → 11/11 00h  site FECHADO (decisão do Gabriel, 05/11):
                           tela cheia com o Grupo VIP e "entrar na conta".
                           Acesso antecipado para quem está logado e já
                           comprou E para quem abre o link do grupo VIP
                           (?acesso=vip1111, que a Sarah manda no grupo VIP
                           e nos grupos antigos; fica salvo no aparelho).
    10/11 20h → 11/11 23h59  tarja com contagem, banner na home, aviso na
                           página de produto e Coenzima Q10 de brinde
                           entrando sozinha no carrinho acima de R$ 500.
    11/11 18h → 23h59      tarja e banner viram "últimas horas".
  Para ver antes da data: ?onze=1 simula a madrugada (site fechado) e
  ?onze=2 simula o dia 11 aberto (fica salvo na aba; ?onze=0 desliga).
  O desconto, o frete grátis e o brinde em si são regras da Shopify;
  este arquivo só mostra, bloqueia e adiciona o brinde ao carrinho.
  ============================================================
{%- endcomment -%}
{%- liquid
  assign onze_early = 1794351600
  assign onze_open = 1794366000
  assign onze_last = 1794430800
  assign onze_end = 1794452399
  assign onze_buyer = false
  if customer and customer.orders_count > 0
    assign onze_buyer = true
  endif
  assign onze_page = request.path
-%}
<template id="bk-onze-gate">
<div class="bk-onze-gate" role="dialog" aria-modal="true" aria-label="O 11/11 abre à meia-noite">
  <div class="bk-onze-gate__box">
    <img class="bk-onze-gate__logo" src="https://cdn.shopify.com/s/files/1/0780/7238/1672/files/logo-c.png" alt="Botanika" width="180" height="34">
    <span class="bk-onze-gate__eye">11/11 · só 24 horas</span>
    <h2 class="bk-onze-gate__h">O maior desconto da história da Botanika <em>abre à meia-noite.</em></h2>
    <p class="bk-onze-gate__p">Até <b>40% OFF</b> e <b>frete grátis em todos os pedidos</b>, só no dia 11/11.</p>
    <div class="bk-onze-gate__count">Abre em <b data-bk-onze-open>--</b></div>
    <form class="bk-onze-gate__pw" data-bk-onze-pw novalidate>
      <p class="bk-onze-gate__pwt">Recebeu a senha do acesso antecipado?</p>
      <div class="bk-onze-gate__pwr"><input name="pw" type="text" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="Digite a senha" aria-label="Senha do acesso antecipado"><button type="submit">Entrar</button></div>
      <p class="bk-onze-gate__err" data-bk-onze-pwerr hidden>Senha incorreta. Confira e tente de novo.</p>
    </form>
    <a class="bk-onze-gate__vip" href="https://sndflw.com/i/botanika-vip?utm_source=site&amp;utm_medium=tela_fechada&amp;utm_campaign=11-11" target="_blank" rel="noopener">Ainda não tem a senha? <b>Entre no Grupo VIP</b></a>
    <style>
      .bk-onze-gate{align-items:flex-start!important;padding-top:max(36px,env(safe-area-inset-top))!important;padding-bottom:36px!important}
      .bk-onze-gate__box{margin:auto}
      .bk-onze-gate__pw{margin:6px 0 0;padding:18px 16px;border:1.5px solid rgba(255,255,255,.22);border-radius:16px;background:#141419;text-align:center}
      .bk-onze-gate__pwt{margin:0 0 12px;font-size:17px;color:#fff;font-weight:800}
      .bk-onze-gate__pwr{display:flex;gap:8px}
      .bk-onze-gate__pwr input{flex:1;min-width:0;height:52px;border-radius:12px;border:1px solid rgba(255,255,255,.3);background:#0b0b0f;color:#fff;font-size:17px;padding:0 16px;text-transform:lowercase;font-family:inherit}
      .bk-onze-gate__pwr input:focus{outline:none;border-color:#e3132b}
      .bk-onze-gate__pwr input::placeholder{color:#9a9aa6;text-transform:none;opacity:1}
      .bk-onze-gate__pwr button{height:52px;padding:0 24px;border:0;border-radius:12px;background:#e3132b;color:#fff;font-weight:800;font-size:16px;cursor:pointer;font-family:inherit}
      .bk-onze-gate__pw .bk-onze-gate__err{margin-top:10px}
      .bk-onze-gate__vip{display:block;margin-top:16px;color:#d6d6de!important;font-size:14.5px;text-decoration:none}
      .bk-onze-gate__vip b{color:#fff;text-decoration:underline}
    </style>
  </div>
</div>
</template>
{%- render 'bk-1111-css' -%}
<template id="bk-onze-bar">
<div class="bk-onze bk-onze-bar">
  <span class="bk-onze-bar__tag" data-bk-onze-tag>11/11</span>
  <span>até <b>40% OFF</b> · frete grátis sem mínimo · Q10 de brinde acima de R$500</span>
  <span class="bk-onze-bar__t">termina em <b data-bk-onze-count>--</b></span>
  <a class="bk-onze-bar__cta" href="/#mais-vendidos">Comprar</a>
</div>
</template>
{%- if template.name == 'index' -%}
<template id="bk-onze-home">
<section class="bk-onze bk-onze-home" aria-label="11/11 Botanika">
  <div class="bk-onze-home__in">
    <div class="bk-onze-home__tx">
      <span class="bk-onze-home__eye" data-bk-onze-tag>11/11 · só hoje</span>
      <h2 class="bk-onze-home__h">Até <em>40% OFF</em> no maior desconto da história da Botanika.</h2>
      <ul class="bk-onze-home__perks">
        <li>🚚 <b>Frete grátis em todos os pedidos</b>, sem mínimo</li>
        <li>🎁 <b>Coenzima Q10 de presente</b> nas compras acima de R$500</li>
        <li>💸 <b>15% de cashback</b> para a próxima compra nos 100 primeiros pedidos</li>
      </ul>
      <div class="bk-onze-home__row">
        <a class="bk-onze-home__cta" href="/collections/mais-vendidos">Comprar agora</a>
        <span class="bk-onze-home__t">Termina em <b data-bk-onze-count>--</b></span>
      </div>
      <p class="bk-onze-home__note">Só no dia 11/11, até 23h59. Desconto aplicado automaticamente.</p>
    </div>
    <div class="bk-onze-home__img">
      <img src="https://cdn.shopify.com/s/files/1/0780/7238/1672/files/lp1111-hero.webp?v=1793298282" alt="Linha Botanika" width="755" height="450" loading="eager">
    </div>
  </div>
</section>
</template>
{%- endif -%}
{%- if template.name == 'product' -%}
<template id="bk-onze-pdp">
  <div class="bk-onze-pdp">
    <div class="bk-onze-pdp__h"><b data-bk-onze-tag>11/11</b> · termina em <b data-bk-onze-count>--</b></div>
    <div class="bk-onze-pdp__p">Até <b>40% OFF</b> · 🚚 frete grátis sem mínimo · 🎁 Q10 de brinde acima de R$500 · 💸 15% de cashback nos 100 primeiros pedidos</div>
    <div class="bk-onze-pdp__s">Desconto aplicado automaticamente no carrinho.</div>
  </div>
</template>
{%- endif -%}
<script>
(function(){
  if (window.__bkOnze) return; window.__bkOnze = true;
  var EARLY = {{ onze_early }} * 1000, OPEN = {{ onze_open }} * 1000, LAST = {{ onze_last }} * 1000, END = {{ onze_end }} * 1000;
  var BUYER = {{ onze_buyer }};
  /* 05/11: o brinde é o produto "Coenzima Q10 · Brinde" a R$ 0 (oculto), e não mais um desconto "compre X, ganhe Y". */
  var GIFT = 68122684457192, MIN = 50000;
  /* prévia: ?onze=1 madrugada (fechado), ?onze=2 dia 11 aberto, ?onze=0 desliga */
  try { var m = location.search.match(/[?&]onze=([012])\b/); if (m) { if (m[1] === '0') sessionStorage.removeItem('bkOnze'); else sessionStorage.setItem('bkOnze', m[1]); } } catch (e) {}
  var shift = 0;
  try { var pv = sessionStorage.getItem('bkOnze'); if (pv === '1') shift = (EARLY + 3600e3) - Date.now(); else if (pv === '2') shift = (OPEN + 3600e3) - Date.now(); } catch (e) {}
  function now(){ return Date.now() + shift; }
  /* acesso antecipado do grupo VIP: o link ?acesso=vip1111 libera o site neste aparelho */
  var VIP = false;
  try { if (/[?&]acesso=vip1111\b/i.test(location.search)) localStorage.setItem('bkOnzeVip', '1'); VIP = localStorage.getItem('bkOnzeVip') === '1'; } catch (e) { VIP = /[?&]acesso=vip1111\b/i.test(location.search); }
  /* tema exclusivo do 11/11 (publicado em 10/11 às 20h): fica ligado até o fim do dia 11 */
  function on(){ return now() <= END; }
  if (!on()) return;

  function pad(n){ return n < 10 ? '0' + n : '' + n; }
  function fmt(ms){ var s = Math.max(0, Math.floor(ms / 1000)); return pad(Math.floor(s / 3600)) + 'h ' + pad(Math.floor(s % 3600 / 60)) + 'm ' + pad(s % 60) + 's'; }
  var path = location.pathname;
  var exempt = /^\/(account|challenge|password|policies|pages\/grupo-vip-11-11)/.test(path);
  function closed(){ var n = now(); return n >= EARLY && n < OPEN && !BUYER && !VIP && !exempt; }

  function show(){
    if (closed()) {
      var g = document.getElementById('bk-onze-gate');
      if (g && !document.querySelector('.bk-onze-gate')) { document.body.appendChild(g.content.cloneNode(true)); document.documentElement.classList.add('bk-onze-locked'); }
      return;
    }
    var gate = document.querySelector('.bk-onze-gate'); if (gate) { gate.remove(); document.documentElement.classList.remove('bk-onze-locked'); }
    var bar = document.getElementById('bk-onze-bar');
    if (bar && !document.querySelector('.bk-onze-bar')) document.body.insertBefore(bar.content.cloneNode(true), document.body.firstChild);
    var home = document.getElementById('bk-onze-home'), main = document.getElementById('MainContent');
    if (home && main && !document.querySelector('.bk-onze-home')) main.insertBefore(home.content.cloneNode(true), main.firstChild);
    var tpl = document.getElementById('bk-onze-pdp');
    if (tpl && !document.querySelector('.bk-onze-pdp')) {
      var form = document.querySelector('#MainContent form[action*="/cart/add"]');
      if (form && form.parentNode) form.parentNode.insertBefore(tpl.content.cloneNode(true), form);
    }
  }
  function tick(){
    var n = now();
    document.querySelectorAll('[data-bk-onze-open]').forEach(function(el){ el.textContent = fmt(OPEN - n); });
    document.querySelectorAll('[data-bk-onze-count]').forEach(function(el){ el.textContent = fmt(END - n); });
    if (n >= LAST) document.querySelectorAll('[data-bk-onze-tag]').forEach(function(el){ el.textContent = '11/11 · últimas horas'; });
    if (n >= OPEN && document.querySelector('.bk-onze-gate')) show();
    if (n < END) setTimeout(tick, 1000);
  }
  /* cadastro na tela fechada: nome, e-mail e celular vão para o ActiveCampaign (lista "11/11 · Site fechado — Leads", formulário 3) e liberam o link */
  function lead(){
    var f = document.querySelector('[data-bk-onze-form]'), ok = document.querySelector('[data-bk-onze-ok]');
    if (!f || f.__bk) return; f.__bk = true;
    function done(){ f.hidden = true; ok.hidden = false; }
    try { if (localStorage.getItem('bkOnzeLead') === '1') { done(); return; } } catch (e) {}
    f.addEventListener('submit', function(ev){
      ev.preventDefault();
      var name = f.fullname.value.trim(), email = f.email.value.trim(), digits = f.phone.value.replace(/\D/g, '');
      if (digits.length === 10 || digits.length === 11) digits = '55' + digits;
      var bad = name.length < 2 || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) || digits.length < 12 || digits.length > 13;
      document.querySelector('[data-bk-onze-err]').hidden = !bad;
      if (bad) return;
      var q = 'u=3&f=3&s=&c=0&m=0&act=sub&v=2&or=&jsonp=true&fullname=' + encodeURIComponent(name) + '&email=' + encodeURIComponent(email) + '&phone=' + encodeURIComponent('+' + digits);
      var sc = document.createElement('script'); sc.src = 'https://botanika1.activehosted.com/proc.php?' + q; sc.async = true; document.body.appendChild(sc);
      try { if (window.fbq) fbq('track', 'Lead', { content_name: '11/11 site fechado' }); } catch (e) {}
      try { if (window.gtag) gtag('event', 'generate_lead', { method: '11-11_site_fechado' }); (window.dataLayer = window.dataLayer || []).push({ event: 'onze_lead' }); } catch (e) {}
      try { localStorage.setItem('bkOnzeLead', '1'); } catch (e) {}
      done();
    });
  }
  /* senha do acesso antecipado (a mesma do link): vip1111 libera o site neste aparelho */
  function pw(){
    var f = document.querySelector('[data-bk-onze-pw]');
    if (!f || f.__bk) return; f.__bk = true;
    f.addEventListener('submit', function(ev){
      ev.preventDefault();
      var v = (f.pw.value || '').toLowerCase().replace(/\s+/g, '');
      if (v === 'vip1111') {
        try { localStorage.setItem('bkOnzeVip', '1'); } catch (e) {}
        VIP = true;
        try { if (window.gtag) gtag('event', 'onze_senha_ok'); } catch (e) {}
        show();
      } else { f.querySelector('[data-bk-onze-pwerr]').hidden = false; }
    });
  }
  function start(){ show(); lead(); pw(); tick(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();

  /* Coenzima Q10 de brinde acima de R$ 500 (mesma lógica do cranberry do Esquenta) */
  var of = window.fetch.bind(window), busy = false, timer = null;
  function isCart(){ return document.body.classList.contains('template-cart') || /\/cart(\/|$|\?)/.test(location.pathname); }
  function post(url, body){
    if (!isCart()) { body.sections = ['minicart-form']; body.sections_url = location.pathname; }
    return of(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) }).then(function(r){ return r.json(); });
  }
  function refresh(data){
    if (isCart()) { location.reload(); return; }
    var html = data && data.sections && data.sections['minicart-form'];
    var target = document.getElementById('minicart-form');
    if (html && target) {
      var fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('#minicart-form');
      if (fresh) target.innerHTML = fresh.innerHTML;
      var cn = document.querySelector('cart-notification');
      if (cn && typeof cn.cartAction === 'function') { try { cn.cartAction(); } catch (e) {} }
      if (typeof BlsLazyloadImg !== 'undefined' && BlsLazyloadImg.init) BlsLazyloadImg.init();
    }
    of('/cart.json').then(function(r){ return r.json(); }).then(function(cart){
      document.querySelectorAll('.cart-count').forEach(function(el){ el.innerHTML = el.classList.contains('cart-count-drawer') ? '(' + cart.item_count + ')' : cart.item_count; });
      var ht = document.querySelector('header-total-price'); if (ht && ht.updateTotal) ht.updateTotal(cart);
      var fs = document.querySelector('free-ship-progress-bar'); if (fs && fs.init) fs.init(cart.items_subtotal_price);
    }).catch(function(){});
  }
  function toast(msg){
    try { if (window.CartUtils && CartUtils.showToast) { CartUtils.showToast(msg, 'success'); return; } if (typeof showToast === 'function') showToast(msg, 3000, 'modal-success'); } catch (e) {}
  }
  function reconcile(){
    if (busy || !on() || closed() || shift) return; busy = true;
    of('/cart.js', { headers: { Accept: 'application/json' } }).then(function(r){ return r.json(); }).then(function(cart){
      var paid = 0, gifts = [], giftQty = 0;
      (cart.items || []).forEach(function(it){
        if (it.variant_id === GIFT) { gifts.push(it); giftQty += it.quantity; }
        else paid += it.final_line_price;
      });
      var gift = gifts[0] || null, need = paid >= MIN ? 1 : 0;
      if (need === giftQty && gifts.length <= 1) return;
      var p;
      if (gifts.length > 1) { var up = {}; gifts.forEach(function(g, i){ up[g.key] = i ? 0 : need; }); p = post('/cart/update.js', { updates: up }); }
      else p = gift ? post('/cart/change.js', { id: gift.key, quantity: need })
                    : post('/cart/add.js', { items: [{ id: GIFT, quantity: need, properties: { _brinde: '11/11' } }] });
      return p.then(function(data){
        if (data && data.status) return;
        if (need > giftQty) toast('🎁 Você ganhou a Coenzima Q10 de brinde!');
        refresh(data);
        setTimeout(reconcile, 900);
      });
    }).catch(function(){}).then(function(){ busy = false; });
  }
  window.fetch = function(u){
    var p = of.apply(window, arguments);
    try {
      var url = typeof u === 'string' ? u : (u && u.url) || '';
      if (/\/cart\/(add|change|update|clear)/.test(url)) p.then(function(){ clearTimeout(timer); timer = setTimeout(reconcile, 600); }).catch(function(){});
    } catch (e) {}
    return p;
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reconcile); else reconcile();
})();
</script>
