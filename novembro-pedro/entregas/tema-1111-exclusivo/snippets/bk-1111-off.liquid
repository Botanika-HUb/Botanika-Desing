{%- comment -%}
  11/11 · desconto por produto (curva ABC do Vitor, PDF de 09/11). Os descontos de verdade são 7 descontos
  automáticos na Shopify ("11/11 · 12% OFF" … "11/11 · 40% OFF"), de 10/11 às 20h a 11/11 às 23h59.
  Aqui o tema só MOSTRA o preço com o desconto de cada produto:
  - cards e página de produto: "3x R$ cheio" riscado + "-X%" + parcela e à vista com o desconto
  - custo por dia com o desconto
  - o seletor de potes usa window.BK11_OFF (ver bk-1111-x)
  Conta igual à do PDF do Vitor: desconto = preço × %, arredondado no centavo.
{%- endcomment -%}
<style>
.installment-price.bk11-done .bk11-old{font-size:1.25rem;color:#8a8a96;font-weight:600;white-space:nowrap}
.installment-price.bk11-done .bk11-old s{color:#8a8a96}
.installment-price.bk11-done .bk11-pct{display:inline-block;background:#e3132b;color:#fff;font-weight:800;font-size:1.05rem;line-height:1.3;border-radius:6px;padding:1px 6px;margin-left:4px;vertical-align:middle}
.installment-price.bk11-done .installment-price__parc{color:#e3132b!important}
.installment-price--detail.bk11-done .bk11-old{font-size:1.5rem;margin-bottom:4px}
.installment-price--detail.bk11-done .bk11-pct{font-size:1.3rem;padding:2px 8px}
.installment-price--detail.bk11-done .installment-price__cash{opacity:1;color:#141418}
.installment-price--detail.bk11-done .installment-price__cash b{color:#e3132b}
.installment-price--detail.bk11-done .installment-price__cash s{color:#8a8a96;font-size:.9em;margin-left:4px}
.installment-price--item.bk11-done .bk11-old{font-size:1.15rem}
.installment-price--item.bk11-done .bk11-pct{font-size:.95rem}
</style>
<script>
(function(){
  if (window.__bk11off) return; window.__bk11off = true;
  if (Date.now() >= 1794452400000) return; /* depois de 11/11 23h59 não mostra mais */
  var OFF = window.BK11_OFF = {
    'hair-botanika': 12, 'tetravit-d': 12, 'super-omega-3-coq10': 12, 'whey-balance-chocolate': 12,
    'tri-mg-complex': 15, 'super-vitamina-c': 15,
    'creatina-monohidratada-magnesio-taurato': 20, 'whey-balance-910g-chocolate-botanika': 20, 'nac-botanika': 20, 'kit-da-imunidade': 20,
    'sleep-inositol': 25, 'whey-balance-sem-sabor': 25, 'flexia-botanika': 25, 'kit-sono-relaxamento': 25, 'kit-whey-balance-creatina-taurato': 25,
    'msm-botanika': 30, 'whey-balance-455g-cappuccino-botanika': 30,
    'cranberry-botanika': 35, 'kit-completo-nac-msm-coq10-cranberry': 35,
    'coenzima-q10-botanika': 40, 'nac-xarope-40mg-120ml-morango-botanika': 40
  };
  function hof(href){ var m = String(href || '').match(/\/products\/([^/?#]+)/); return m ? decodeURIComponent(m[1]) : ''; }
  var PAGE = hof(location.pathname);
  window.BK11_PCT = function(h){ return OFF[h || PAGE] || 0; };
  function cents(t){ var m = String(t || '').replace(/\s/g, '').match(/([\d.]+),(\d{2})/); return m ? parseInt(m[1].replace(/\./g, ''), 10) * 100 + parseInt(m[2], 10) : NaN; }
  function money(c){ return 'R$ ' + (c / 100).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function handleOf(el){
    var card = el.closest('.product-item, .product-card');
    var a = card && card.querySelector('a[href*="/products/"]');
    return a ? hof(a.getAttribute('href')) : PAGE;
  }
  function paint(){
    document.querySelectorAll('.installment-price.ip-std:not(.bk11-done)').forEach(function(el){
      var cash = el.querySelector('.installment-price__cash'); if (!cash) return;
      var full = cents(cash.textContent); if (isNaN(full) || full <= 0) return;
      var p = OFF[handleOf(el)]; if (!p) return;
      var off = Math.round(full * p / 100), f = full - off, n = 3;
      var detail = el.classList.contains('installment-price--detail'), item = el.classList.contains('installment-price--item');
      var h = '<span class="bk11-old"><s>' + n + 'x ' + money(Math.floor(full / n)) + '</s> <span class="bk11-pct">' + (detail ? '🔥 -' + p + '% no 11/11' : '-' + p + '%') + '</span></span>';
      if (item) h += '<span class="installment-price__parc primary-color">' + n + 'x de ' + money(Math.floor(f / n)) + '</span><span class="installment-price__tag">sem juros</span><span class="installment-price__cash">ou ' + money(f) + ' à vista</span>';
      else if (detail) h += '<span class="installment-price__parc primary-color">' + n + 'x de ' + money(Math.floor(f / n)) + ' <span class="installment-price__tag">sem juros</span></span><span class="installment-price__cash">ou <b>' + money(f) + '</b> à vista no 11/11 <s>' + money(full) + '</s></span>';
      else h += '<span class="installment-price__parc primary-color">' + n + 'x de ' + money(Math.floor(f / n)) + ' <span class="installment-price__tag">sem juros</span></span><span class="installment-price__cash">ou ' + money(f) + ' à vista <span class="bk11-pct">-' + p + '%</span></span>';
      el.innerHTML = h; el.classList.add('bk11-done');
    });
    /* custo por dia (página de produto) */
    var p = OFF[PAGE];
    if (p) document.querySelectorAll('.bk-dose--std strong:not(.bk11-done)').forEach(function(s){
      var v = cents(s.textContent); if (isNaN(v)) return;
      s.textContent = s.textContent.replace(/R\$\s?[\d.]+,\d{2}/, money(v - Math.round(v * p / 100))); s.classList.add('bk11-done');
      var line = s.closest('.bk-dose__line'); if (line && line.firstChild && line.firstChild.nodeType === 3) line.firstChild.nodeValue = line.firstChild.nodeValue.replace('Sai por', 'No 11/11 sai por');
    });
  }
  var busy = false;
  new MutationObserver(function(){ if (busy) return; busy = true; requestAnimationFrame(function(){ paint(); busy = false; }); }).observe(document.documentElement, { childList: true, subtree: true });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', paint); else paint();
})();
</script>
