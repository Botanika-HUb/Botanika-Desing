html.bk-pv body.index .bkmed__pill.is-active{background:#e3132b!important;border-color:#e3132b!important}
/* 11/11: frete grátis sem mínimo, então some a barra de "faltam R$ X"; a faixa azul de vantagens também some */
html.bk-pv [id$="__trust_bar"],html.bk-pv quantity-discount-cards .qty2__ship,html.bk-pv free-ship-progress-bar,html.bk-pv .bgc{display:none!important}
</style>
