{%- comment -%}
  11/11 · mesma identidade preto e vermelho do Esquenta, valendo de 10/11 às 20h até 11/11 às 23h59 (04/11, pedido do Pedro).
  O Esquenta termina às 20h de 10/11 e o bk-bf-pv deixa de valer. Este snippet coloca a classe bk-pv no <html> durante o 11/11
  e repete só as cores: botões, selos, Mais Vendidos, home preta, brilho nos cards e menu e rodapé.
  Nada de preço, escada ou brinde do Esquenta.
  Também esconde, no 11/11:
    - a faixa azul "3x sem juros";
    - a barra "Faltam R$ X para o frete grátis" (no 11/11 o frete é grátis sem mínimo).
  Prévia: ?onze=1 (madrugada) ou ?onze=2 (dia 11), a mesma do bk-1111.
{%- endcomment -%}
<script>
(function(){
  var EARLY = 1794351600000, END = 1794452399000, shift = 0;
  try { var m = location.search.match(/[?&]onze=([012])\b/); if (m) { if (m[1] === '0') sessionStorage.removeItem('bkOnze'); else sessionStorage.setItem('bkOnze', m[1]); } } catch (e) {}
  try { var pv = sessionStorage.getItem('bkOnze'); if (pv === '1') shift = (EARLY + 3600e3) - Date.now(); else if (pv === '2') shift = (1794394800000 + 3600e3) - Date.now(); } catch (e) {}
  var n = Date.now() + shift;
  /* tema exclusivo do 11/11: sempre ligado */ document.documentElement.classList.add('bk-pv');
})();
</script>
<style>
html.bk-pv{--bf-red:#e3132b;--bf-red2:#b80f22;--bf-black:#0b0b0f;--bf-ink:#141418;
  --color-primary:#e3132b;--color-primary-rgb:227,19,43;--bk-azul:#e3132b;--bk-verde:#e3132b;
  --btn-primary-bg-color:#e3132b;--btn-primary-hover-bg-color:#b80f22;--btn-primary-bg-graident-color:#e3132b;--btn-primary-hover-bg-color-graident:#b80f22;
  --btn-link-color:#e3132b;--btn-link-hover-color:#b80f22;--btn-outline-color:#e3132b;--btn-outline-border-color:#e3132b;--color-link-hover:#e3132b}
/* botões de compra: vermelho com texto branco */
html.bk-pv .product-item .product__add-cart.morden-style,html.bk-pv .product-item .product__add-cart,html.bk-pv .product__add-cart,html.bk-pv .bkc__btn,html.bk-pv .btn.btn-primary,html.bk-pv .bkp__cta,html.bk-pv .product-form__submit,html.bk-pv .product_submit_button,html.bk-pv .bkm__wpp,html.bk-pv .bf__btn,html.bk-pv .bsn__copy{background:var(--bf-red)!important;border-color:var(--bf-red)!important;color:#fff!important;box-shadow:0 8px 20px -8px rgba(227,19,43,.6)!important}
html.bk-pv .product__add-cart *,html.bk-pv .bkc__btn *,html.bk-pv .btn.btn-primary *,html.bk-pv .bkp__cta *{color:#fff!important}
html.bk-pv .product-item .product__add-cart.morden-style:hover,html.bk-pv .product__add-cart:hover,html.bk-pv .bkc__btn:hover,html.bk-pv .btn.btn-primary:hover{background:var(--bf-red2)!important}
/* tarja e caixa do carrinho: sem verde */
/* selos: faixa preta */
html.bk-pv .bks{background:var(--bf-black)!important}
html.bk-pv .bks,html.bk-pv .bks *{color:#fff!important}
html.bk-pv .bks [class*="sub"],html.bk-pv .bks small,html.bk-pv .bks p{color:#c9c9d3!important}
html.bk-pv .bks__icone{background:rgba(227,19,43,.18)!important;color:#ff5a6b!important}
