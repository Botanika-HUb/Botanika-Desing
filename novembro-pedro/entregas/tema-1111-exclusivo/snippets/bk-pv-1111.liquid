html.bk-pv .product-item__inner:has(.card-benefit-badge) .product__badges{top:42px!important}
@keyframes bkpvGlow{0%,100%{box-shadow:0 0 0 1px rgba(227,19,43,.35),0 0 10px 0 rgba(227,19,43,.25)}50%{box-shadow:0 0 0 2px rgba(227,19,43,.85),0 0 26px 4px rgba(227,19,43,.55)}}
html.bk-pv .product-item .product-item__wrapper{border-radius:18px;animation:bkpvGlow 2.4s ease-in-out infinite}
