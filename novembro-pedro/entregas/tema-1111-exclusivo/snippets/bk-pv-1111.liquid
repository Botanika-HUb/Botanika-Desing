html.bk-pv body.index :is(.ugc__title,.btcar__title,.btcol-title,.bt-medauth__title,.bkmed__h,.bk__h,.bkcat__h),html.bk-pv body.index [id$="__featured_collection_Pd7APa"] .section__header-heading{color:#fff!important}
