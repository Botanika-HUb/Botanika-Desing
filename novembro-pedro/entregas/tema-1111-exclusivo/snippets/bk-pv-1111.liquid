html.bk-pv quantity-discount-cards.qty2{--q-blue:#e3132b;--q-blue2:#ff4b5f;--q-ink:#141418;--q-sel:#fff5f6;--q-gold:#e3132b;--q-gold-ink:#fff}
html.bk-pv .qty2__ship-fill{background:linear-gradient(90deg,#b80f22,#e3132b)!important}
html.bk-pv .bkp__qi,html.bk-pv .bkp__tick,html.bk-pv .bkp__stepn,html.bk-pv .bkab__ic{background:linear-gradient(160deg,#e3132b,#5a0610 72%)!important}
