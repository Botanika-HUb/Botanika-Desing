html.bk-pv .menu_label{background:var(--bf-red)!important}
/* bloco "Sua primeira compra" e rodapé/menu em preto */
html.bk-pv .bsn__panel{background:radial-gradient(120% 140% at 12% 8%,#3a0a10 0%,#0b0b0f 70%)!important}
html.bk-pv .submenu-horizontal,html.bk-pv nav.mobile,html.bk-pv footer.bf{background:var(--bf-black)!important}
