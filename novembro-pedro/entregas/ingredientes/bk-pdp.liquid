    .bkp__media--video,.bkp__panel--close .bkp__media--video{min-height:0;width:auto;aspect-ratio:9/16}
    .bkp__panel--close .bkp__media--video{order:-1}
    .bkp__mq{border-radius:18px;padding:10px 0 10px 14px;gap:10px}
    .bkp__mq-t{display:none}
    .bkp__mq-view{-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
    .bkp__media::after{background:linear-gradient(180deg,rgba(35,43,102,0) 55%,rgba(35,43,102,.45) 100%)}
    .bkp__pcontent{padding:32px 24px}
    .bkp__steps,.bkp__notes{grid-template-columns:1fr}
    .bkp__head{margin-bottom:26px}
    .bkp__why{padding:24px}
  }
  @media (max-width:520px){
    .bkp__grid--4{grid-template-columns:1fr}
    .bkp__proof{flex-basis:72vw}
    .bkp__card{padding:20px}
  }
  @media (prefers-reduced-motion:reduce){.bkp__cta,.bkp__qi::before,.bkp__qi::after,.bkp__proof,.bkp__card{transition:none}.bkp__mq-track{animation:none}.bkp--glass .bkp__orbs i{animation:none}.bkp__band--navy .bkp__eb::before,.bkts__img,.bkts__qi,.bkp__band--navy .bkp__h .bkp__w:last-child>span{animation:none}}
{%- endstyle -%}

