  .bkp--glass .bkp__panel::before,.bkp--glass .bkp__why::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;background:linear-gradient(140deg,rgba(255,255,255,.7),rgba(255,255,255,.12) 30%,rgba(255,255,255,0) 55%,rgba(196,215,138,.5));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none;z-index:3}
