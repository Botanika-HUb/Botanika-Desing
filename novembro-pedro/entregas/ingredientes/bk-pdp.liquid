{%- comment -%}
  ============================================================
  Botanika — página de produto no padrão novo (todas as PDPs).
  Textos próprios de cada produto (metafields custom.*):
    bk_nome (etiqueta), bk_hero_title, bk_hero_chips ("a|b|c"),
    bk_close_title, bk_cta, bk_not_for (opcional, 1 por linha).
  Vazio no produto = usa o texto do bloco no template.
  Vídeos opcionais (metafield de arquivo, vídeo): bk_hero_video,
  bk_forwhom_video, bk_close_video — substituem a foto da faixa.
  Linguagem visual tirada do bloco "Mais saúde para o seu dia"
  da home: painel azul em degradê, etiqueta verde-claro, títulos
  fortes, selos em pílula com contorno e botão em pílula.

  Uma seção com blocos: cada bloco é uma faixa da página e lê o
  conteúdo dos metafields do próprio produto (custom.*). Bloco
  sem conteúdo no produto não aparece. Assim o mesmo padrão
  serve para outros produtos, só preenchendo os metafields.
  ============================================================
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  assign glass = false
  assign glass_list = section.settings.glass_handles | split: ','
  for gh in glass_list
    assign ghs = gh | strip
    if ghs == '*' or ghs == product.handle
      assign glass = true
    endif
  endfor
-%}
<div class="bkp{% if glass %} bkp--glass{% endif %}" id="bkp-{{ section.id }}">
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    {%- case block.type -%}

      {%- when 'hero' -%}
        {%- assign img = mf.hero_image.value -%}
        {%- assign hvid = mf.bk_hero_video.value -%}
        {%- assign body = mf.manifesto_body.value | default: b.body -%}
        {%- assign h_eb = mf.bk_nome.value | default: b.eyebrow -%}
        {%- assign h_title = mf.bk_hero_title.value | default: b.title -%}
        {%- assign h_chips = mf.bk_hero_chips.value | default: b.chips -%}
        {%- assign h_cta = mf.bk_cta.value | default: b.cta -%}
        {%- if body != blank or h_title != blank -%}
          <section class="bkp__band bkp__band--hero" {{ block.shopify_attributes }}>
            <div class="bkp__wrap">
              <div class="bkp__gl">{%- if glass -%}<span class="bkp__orbs" aria-hidden="true"><i></i><i></i><i></i></span>{%- endif -%}
              <div class="bkp__panel bkp__rv{% if img == blank and hvid == blank %} bkp__panel--solo{% endif %}{% if hvid != blank %} bkp__panel--hv{% endif %}">
                {%- if hvid != blank -%}
                  <div class="bkp__media bkp__media--video">{%- render 'bk-pdp-video', video: hvid, label: product.title -%}</div>
                {%- elsif img != blank -%}
                  <div class="bkp__media">{{ img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 900px) 50vw, 100vw', alt: product.title }}</div>
                {%- endif -%}
                <div class="bkp__pcontent">
                  {%- if h_eb != blank -%}<span class="bkp__eb bkp__eb--lime">{{ h_eb }}</span>{%- endif -%}
                  {%- if h_title != blank -%}<h2 class="bkp__h bkp__h--light">{{ h_title }}</h2>{%- endif -%}
                  {%- if body != blank -%}
                    <div class="bkp__sub bkp__sub--light">
                      {%- assign paras = body | newline_to_br | split: '<br />' -%}
                      {%- for p in paras -%}{%- assign pt = p | strip -%}{%- if pt != blank -%}<p>{{ pt }}</p>{%- endif -%}{%- endfor -%}
                    </div>
                  {%- endif -%}
                  {%- render 'bk-pdp-chips', list: h_chips, light: true -%}
                  {%- if h_cta != blank -%}<button type="button" class="bkp__cta bkp__cta--white" data-bkp-buy>{{ h_cta }}</button>{%- endif -%}
                </div>
              </div>
              </div>
              {%- comment -%} Faixa corrida com os ativos e doses da tabela nutricional (só se houver 3+). {%- endcomment -%}
              {%- assign mq_n = 0 -%}
              {%- capture mq -%}
                {%- for n in mf.nutrition_table.value.nutrientes -%}
                  {%- assign low = n.nome | downcase -%}
                  {%- unless low contains 'energ' or low contains 'carboidrat' or low contains 'açúcar' or low contains 'gordura' or low contains 'sódio' or low contains 'colesterol' or low contains 'fibra' or low contains 'prote' -%}
                    {%- assign nm = n.nome | split: ' (' | first | strip -%}
                    {%- assign un = '' -%}
                    {%- if n.nome contains '(' -%}{%- assign un = n.nome | split: '(' | last | remove: ')' | strip -%}{%- endif -%}
                    <span class="bkp__mq-i"><b>{{ nm }}</b> {{ n.por_porcao }}{% if un != blank %} {{ un }}{% endif %}</span>
                    {%- assign mq_n = mq_n | plus: 1 -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if mq_n >= 3 -%}
                <div class="bkp__mq" aria-label="Ativos por porção">
                  <span class="bkp__mq-t">Em cada porção</span>
                  <div class="bkp__mq-view"><div class="bkp__mq-track" data-bkp-mq>{{ mq }}<span class="bkp__mq-dup" aria-hidden="true">{{ mq }}</span></div></div>
                </div>
              {%- endif -%}
            </div>
          </section>
        {%- endif -%}

      {%- when 'forwhom' -%}
        {%- assign yes_raw = mf.for_whom_items.value -%}
        {%- if yes_raw != blank -%}
          {%- assign img = mf.para_quem_image.value -%}
          {%- assign fvid = mf.bk_forwhom_video.value -%}
          {%- assign not_for = mf.bk_not_for.value | default: b.not_for -%}
          <section class="bkp__band bkp__band--{{ b.bg }}" {{ block.shopify_attributes }}>
            <div class="bkp__wrap bkp__split{% if img == blank and fvid == blank %} bkp__split--solo{% endif %}{% if fvid != blank %} bkp__split--v{% endif %}">
              {%- if fvid != blank -%}
                <div class="bkp__photo bkp__photo--video bkp__rv">{%- render 'bk-pdp-video', video: fvid, label: product.title -%}</div>
              {%- elsif img != blank -%}
                <div class="bkp__photo">{{ img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,800,1000', sizes: '(min-width: 900px) 45vw, 100vw', alt: product.title }}</div>
              {%- endif -%}
              <div class="bkp__col">
                {%- if b.eyebrow != blank -%}<span class="bkp__eb">{{ b.eyebrow }}</span>{%- endif -%}
                {%- if b.title != blank -%}<h2 class="bkp__h">{{ b.title }}</h2>{%- endif -%}
                <ul class="bkp__list bkp__list--yes">
                  {%- assign yes_list = yes_raw | newline_to_br | split: '<br />' -%}
                  {%- for it in yes_list -%}{%- assign t = it | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
                </ul>
                {%- if not_for != blank -%}
                  <div class="bkp__not">
                    {%- if b.not_title != blank -%}<p class="bkp__not-t">{{ b.not_title }}</p>{%- endif -%}
                    <ul class="bkp__list bkp__list--no">
                      {%- assign no_list = not_for | newline_to_br | split: '<br />' -%}
                      {%- for it in no_list -%}{%- assign t = it | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </section>
        {%- endif -%}

      {%- when 'inside' -%}
        {%- if mf.ingredient_1_title != blank -%}
          <section class="bkp__band bkp__band--{{ b.bg }}" {{ block.shopify_attributes }}>
            <div class="bkp__wrap">
              <div class="bkp__head">
                {%- if b.eyebrow != blank -%}<span class="bkp__eb">{{ b.eyebrow }}</span>{%- endif -%}
                {%- if b.title != blank -%}<h2 class="bkp__h">{{ b.title }}</h2>{%- endif -%}
                {%- if mf.ingredients_subheading != blank -%}<p class="bkp__sub">{{ mf.ingredients_subheading }}</p>{%- endif -%}
              </div>
              <div class="bkp__grid bkp__grid--3">
                {%- for i in (1..3) -%}
                  {%- assign tk = 'ingredient_' | append: i | append: '_title' -%}
                  {%- assign dk = 'ingredient_' | append: i | append: '_description' -%}
                  {%- if mf[tk] != blank -%}
                    <div class="bkp__card">
                      <h3 class="bkp__ct">{{ mf[tk] }}</h3>
                      {%- if mf[dk] != blank -%}<p class="bkp__cd">{{ mf[dk] }}</p>{%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if mf.why_combo_body != blank -%}
                <div class="bkp__gl bkp__gl--why">{%- if glass -%}<span class="bkp__orbs" aria-hidden="true"><i></i><i></i><i></i></span>{%- endif -%}<div class="bkp__why">
                  <span class="bkp__eb bkp__eb--lime">{{ b.why_title | default: 'Por que essa combinação' }}</span>
                  <p data-bkp-scrub>{{ mf.why_combo_body }}</p>
                </div></div>
              {%- endif -%}
            </div>
          </section>
        {%- endif -%}

      {%- when 'benefits' -%}
        {%- assign items = mf.benefit_items.value -%}
        {%- if items != blank -%}
          <section class="bkp__band bkp__band--{{ b.bg }}" {{ block.shopify_attributes }}>
            <div class="bkp__wrap">
              <div class="bkp__head">
                {%- if b.eyebrow != blank -%}<span class="bkp__eb">{{ b.eyebrow }}</span>{%- endif -%}
                {%- if b.title != blank -%}<h2 class="bkp__h">{{ b.title }}</h2>{%- endif -%}
              </div>
              <div class="bkp__grid bkp__grid--4">
                {%- for it in items -%}
                  <div class="bkp__card bkp__card--benefit">
                    <span class="bkp__tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span>
                    <h3 class="bkp__ct">{{ it.title }}</h3>
                    {%- if it.description != blank -%}<p class="bkp__cd">{{ it.description }}</p>{%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </section>
        {%- endif -%}

      {%- when 'proofs' -%}
        {%- comment -%} Só fotos do produto; sem fotos próprias, usa as genéricas do bloco (g1..g12). {%- endcomment -%}
        {%- assign has_own = false -%}
        {%- for pic in mf.provas_sociais.value -%}
          {%- if pic.media_type == 'image' -%}{%- assign has_own = true -%}{%- endif -%}
        {%- endfor -%}
        {%- assign has_gen = false -%}
        {%- for i in (1..12) -%}
          {%- assign gk = 'g' | append: i -%}
          {%- if b[gk] != blank -%}{%- assign has_gen = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_own or has_gen -%}
          {%- capture pics -%}
            {%- if has_own -%}
              {%- for pic in mf.provas_sociais.value -%}
                {%- if pic.media_type == 'image' -%}<div class="bkp__proof">{{ pic | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', sizes: '(min-width: 900px) 300px, 72vw', alt: 'Story de cliente' }}</div>{%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..12) -%}
                {%- assign gk = 'g' | append: i -%}
                {%- if b[gk] != blank -%}<div class="bkp__proof">{{ b[gk] | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', sizes: '(min-width: 900px) 300px, 72vw', alt: 'Story de cliente' }}</div>{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endcapture -%}
          <section class="bkp__band bkp__band--{{ b.bg }}" {{ block.shopify_attributes }}>
            <div class="bkp__wrap"{% if b.bg == 'navy' %} data-bkp-navy{% endif %}>
              {%- if b.bg == 'navy' and glass -%}<span class="bkp__orbs" aria-hidden="true"><i></i><i></i><i></i></span>{%- endif -%}
              <div class="bkp__head">
                {%- if b.eyebrow != blank -%}<span class="bkp__eb">{{ b.eyebrow }}</span>{%- endif -%}
                {%- if b.title != blank -%}<h2 class="bkp__h">{{ b.title }}</h2>{%- endif -%}
                {%- if b.sub != blank -%}<p class="bkp__sub">{{ b.sub }}</p>{%- endif -%}
              </div>
              {%- if b.bg == 'navy' -%}
                {%- comment -%}
                  Slider: um print grande por vez + avaliação real do Judge.me ao lado (fontes diferentes, cada uma com seu selo).
                  Avaliações: só 5 estrelas, com texto de 60+ caracteres, sem anônimas e sem números/percentuais (evita promessa de resultado).
                {%- endcomment -%}
                {%- comment -%} Poucas ou nenhuma avaliação boa do próprio produto: completa com avaliações reais de outros produtos Botanika (com o nome do produto no selo). {%- endcomment -%}
                {%- assign rv_fb = section.settings.rev_fallback | default: 'whey-balance-chocolate,super-vitamina-c,creatina-l-carnitina,tri-mg-complex,hair-botanika' -%}
                {%- assign srcs = product.handle | append: ',' | append: rv_fb | split: ',' -%}
                {%- capture revs -%}
                  {%- assign rn = 0 -%}
                  {%- for sh in srcs -%}
                    {%- assign shs = sh | strip -%}
                    {%- assign pl = '' -%}
                    {%- if forloop.first -%}
                      {%- assign sp = product -%}
                      {%- assign cap = 8 -%}
                    {%- else -%}
                      {%- comment -%} Produto com poucas avaliações: completa até 4; sem nenhuma: até 8. {%- endcomment -%}
                      {%- if forloop.index == 2 -%}{%- if rn > 0 -%}{%- assign cap = 4 -%}{%- else -%}{%- assign cap = 8 -%}{%- endif -%}{%- endif -%}
                      {%- if rn >= cap -%}{%- break -%}{%- endif -%}
                      {%- if shs == blank or shs == product.handle -%}{%- continue -%}{%- endif -%}
                      {%- assign sp = all_products[shs] -%}
                      {%- assign pl = sp.metafields.custom.bk_nome.value | default: sp.title | split: ' — ' | first | strip -%}
                    {%- endif -%}
                    {%- assign jr = sp.metafields.judgeme.review_widget_json_ld.value.review -%}
                    {%- for r in jr -%}
                      {%- if rn >= cap -%}{%- break -%}{%- endif -%}
                      {%- assign body = r.reviewBody | strip -%}
                      {%- assign an = r.author.name | strip -%}
                      {%- if r.reviewRating.ratingValue == 5 and body.size >= 60 and an != blank and an != 'Anônimo' -%}{%- unless body contains '%' -%}
                        {%- assign parts = an | split: ' ' -%}
                        {%- assign nm = parts.first -%}
                        {%- if parts.size > 1 -%}{%- assign ini = parts.last | slice: 0 | upcase -%}{%- assign nm = nm | append: ' ' | append: ini | append: '.' -%}{%- endif -%}
                        {%- if rn > 0 -%},{%- endif -%}{"n":{{ nm | json }},"q":{{ body | json }},"p":{{ pl | json }}}
                        {%- assign rn = rn | plus: 1 -%}
                      {%- endunless -%}{%- endif -%}
                    {%- endfor -%}
                  {%- endfor -%}
                {%- endcapture -%}
                <div class="bkts" data-bkts>
                  <template data-bkts-p>{{ pics }}</template>
                  <script type="application/json" data-bkts-r>[{{ revs }}]</script>
                  <div class="bkts__meta">
                    <div><span class="bkts__count" data-bkts-c></span><div class="bkts__vert">{{ b.eyebrow | default: 'Quem usa' }}</div></div>
                    <div class="bkts__thumbs"></div>
                  </div>
                  <div class="bkts__stage"></div>
                  <div class="bkts__txt">
                    <div class="bkts__q" aria-live="polite"></div>
                    <div class="bkts__nav">
                      <button type="button" class="bkts__btn" data-bkts-v aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
                      <button type="button" class="bkts__btn bkts__btn--p" data-bkts-n aria-label="Próximo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
                    </div>
                  </div>
                </div>
              {%- else -%}
                <div class="bkp__proofs">{{ pics }}</div>
              {%- endif -%}
            </div>
          </section>
        {%- endif -%}

      {%- when 'howto' -%}
        {%- assign raw = mf.how_to_steps.value | default: mf.how_to_take_steps.value -%}
        {%- if raw != blank -%}
          {%- assign lines = raw | newline_to_br | split: '<br />' -%}
          <section class="bkp__band bkp__band--{{ b.bg }}" {{ block.shopify_attributes }}>
            <div class="bkp__wrap">
              <div class="bkp__head">
                {%- if b.eyebrow != blank -%}<span class="bkp__eb">{{ b.eyebrow }}</span>{%- endif -%}
                {%- if b.title != blank -%}<h2 class="bkp__h">{{ b.title }}</h2>{%- endif -%}
              </div>
              <ol class="bkp__steps">
                {%- assign sn = 0 -%}
                {%- for ln in lines -%}
                  {%- assign t = ln | strip -%}
                  {%- assign low = t | downcase -%}
                  {%- if low contains 'passo' -%}
                    {%- assign sn = sn | plus: 1 -%}
                    {%- assign txt = t | split: ':' | last | strip -%}
                    <li class="bkp__step"><span class="bkp__stepn">{{ sn }}</span><span class="bkp__stept">{{ txt }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ol>
              <div class="bkp__notes">
                {%- for ln in lines -%}
                  {%- assign t = ln | strip -%}
                  {%- assign low = t | downcase -%}
                  {%- unless t == blank or low contains 'passo' -%}
                    {%- if t contains ':' -%}
                      {%- assign k = t | split: ':' | first | strip -%}
                      {%- assign v = t | remove_first: k | remove_first: ':' | strip -%}
                      <div class="bkp__note"><span class="bkp__eb">{{ k }}</span><p>{{ v }}</p></div>
                    {%- else -%}
                      <div class="bkp__note"><p>{{ t }}</p></div>
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
          </section>
        {%- endif -%}

      {%- when 'specs' -%}
        {%- assign nt = mf.nutrition_table.value -%}
        {%- assign ru = mf.responsible_use_items.value -%}
        {%- if nt != blank or ru != blank -%}
          <section class="bkp__band bkp__band--{{ b.bg }}" {{ block.shopify_attributes }}>
            <div class="bkp__wrap">
              <div class="bkp__head">
                {%- if b.eyebrow != blank -%}<span class="bkp__eb">{{ b.eyebrow }}</span>{%- endif -%}
                {%- if b.title != blank -%}<h2 class="bkp__h">{{ b.title }}</h2>{%- endif -%}
              </div>
              <div class="bkp__specs">
                {%- if nt != blank -%}
                  <div class="bkp__card bkp__card--table">
                    <h3 class="bkp__ct">{{ b.table_title | default: 'Informação nutricional' }}</h3>
                    <p class="bkp__cd">Porção: {{ nt.porcao }}{% if nt.porcoes_embalagem != blank %} · {{ nt.porcoes_embalagem }} porções por embalagem{% endif %}</p>
                    <div class="bkp__tblwrap">
                      <table class="bkp__tbl">
                        <thead><tr><th>Nutriente</th><th>Por porção</th><th>%VD*</th></tr></thead>
                        <tbody>
                          {%- for n in nt.nutrientes -%}
                            {%- assign vdn = n.vd | remove: '%' | strip | replace: ',', '.' | plus: 0 -%}
                            {%- assign vdw = vdn | at_most: 100 -%}
                            <tr><td>{{ n.nome }}{%- if vdn > 0 -%}<span class="bkp__vdbar{% if vdn > 100 %} is-over{% endif %}" aria-hidden="true"><i style="--w:{{ vdw }}%"></i></span>{%- endif -%}</td><td>{{ n.por_porcao }}</td><td>{{ n.vd }}</td></tr>
                          {%- endfor -%}
                        </tbody>
                      </table>
                    </div>
                    {%- if nt.observacao != blank -%}<p class="bkp__small">{{ nt.observacao }}</p>{%- endif -%}
                    {%- if nt.rodape != blank -%}<p class="bkp__small">{{ nt.rodape }}</p>{%- endif -%}
                  </div>
                {%- endif -%}
                {%- if ru != blank -%}
                  <div class="bkp__card">
                    <h3 class="bkp__ct">{{ b.ru_title | default: 'Uso responsável' }}</h3>
                    <ul class="bkp__list bkp__list--yes">
                      {%- assign rl = ru | newline_to_br | split: '<br />' -%}
                      {%- for it in rl -%}{%- assign t = it | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </section>
        {%- endif -%}

        {%- comment -%}
          07/11 · Ingredientes (pedido do Pedro), logo abaixo do "O que diz o rótulo".
          Texto do rótulo no campo do produto custom.ingredientes, uma linha por cartão: "Título|texto".
          "selo|texto" vira etiqueta. Fórmula e Cápsula viram lista; nos kits, um cartão por produto.
        {%- endcomment -%}
        {%- assign ingr = mf.ingredientes.value | default: mf.ingredientes -%}
        {%- if ingr != blank -%}
          {%- assign ilines = ingr | newline_to_br | split: '<br />' -%}
          <section class="bkp__band bkp__band--white bkp__ingr" aria-label="Ingredientes">
            <div class="bkp__wrap">
              <div class="bkp__head">
                <span class="bkp__eb">Ingredientes</span>
                <h2 class="bkp__h">Do que é feito</h2>
                <p class="bkp__sub">A lista completa de ingredientes, igual à do rótulo.</p>
              </div>
              <div class="bkp__ingr-grid">
                {%- for ln in ilines -%}
                  {%- assign l = ln | strip -%}
                  {%- if l == blank or l contains 'selo|' -%}{%- continue -%}{%- endif -%}
                  {%- assign parts = l | split: '|' -%}
                  {%- assign it = parts[0] | strip -%}
                  {%- assign ix = parts | slice: 1, 9 | join: '|' | strip -%}
                  <div class="bkp__card bkp__ingr-card">
                    <h3 class="bkp__ct">{{ it }}</h3>
                    {%- if it == 'Fórmula' or it == 'Cápsula' -%}
                      <ul class="bkp__ingr-list">
                        {%- assign its = ix | split: ', ' -%}
                        {%- for x in its -%}<li>{{ x | strip }}</li>{%- endfor -%}
                      </ul>
                    {%- else -%}
                      <p class="bkp__cd">{{ ix }}.</p>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
              {%- if ingr contains 'selo|' -%}
                <div class="bkp__chips bkp__ingr-chips">
                  {%- for ln in ilines -%}{%- assign l = ln | strip -%}{%- if l contains 'selo|' -%}<span class="bkp__chip">✓ {{ l | remove_first: 'selo|' | strip }}</span>{%- endif -%}{%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </section>
        {%- endif -%}

      {%- when 'faq' -%}
        {%- assign faqs = mf.faq_items.value -%}
        {%- if faqs != blank -%}
          <section class="bkp__band bkp__band--{{ b.bg }}" {{ block.shopify_attributes }}>
            <div class="bkp__wrap bkp__wrap--narrow">
              <div class="bkp__head">
                {%- if b.eyebrow != blank -%}<span class="bkp__eb">{{ b.eyebrow }}</span>{%- endif -%}
                {%- if b.title != blank -%}<h2 class="bkp__h">{{ b.title }}</h2>{%- endif -%}
              </div>
              <div class="bkp__faq">
                {%- for f in faqs -%}
                  <details class="bkp__q"{% if forloop.first %} open{% endif %}>
                    <summary>{{ f.question }}<span class="bkp__qi" aria-hidden="true"></span></summary>
                    <div class="bkp__a">{{ f.answer }}</div>
                  </details>
                {%- endfor -%}
              </div>
            </div>
          </section>
        {%- endif -%}

      {%- when 'close' -%}
        {%- assign c_title = mf.bk_close_title.value | default: b.title -%}
        {%- assign c_cta = mf.bk_cta.value | default: b.cta -%}
        {%- assign cvid = mf.bk_close_video.value -%}
        <section class="bkp__band" {{ block.shopify_attributes }}>
          <div class="bkp__wrap">
            <div class="bkp__gl">{%- if glass -%}<span class="bkp__orbs" aria-hidden="true"><i></i><i></i><i></i></span>{%- endif -%}
            <div class="bkp__panel bkp__rv{% if cvid == blank %} bkp__panel--solo bkp__panel--center{% else %} bkp__panel--close{% endif %}">
              <div class="bkp__pcontent">
                {%- if b.eyebrow != blank -%}<span class="bkp__eb bkp__eb--lime">{{ b.eyebrow }}</span>{%- endif -%}
                {%- if c_title != blank -%}<h2 class="bkp__h bkp__h--light">{{ c_title }}</h2>{%- endif -%}
                {%- if b.sub != blank -%}<p class="bkp__sub bkp__sub--light">{{ b.sub }}</p>{%- endif -%}
                {%- render 'bk-pdp-chips', list: b.chips, light: true -%}
                {%- if c_cta != blank -%}<button type="button" class="bkp__cta bkp__cta--white" data-bkp-buy>{{ c_cta }}</button>{%- endif -%}
              </div>
              {%- if cvid != blank -%}
                <div class="bkp__media bkp__media--video">{%- render 'bk-pdp-video', video: cvid, label: product.title -%}</div>
              {%- endif -%}
            </div>
            </div>
          </div>
        </section>

    {%- endcase -%}
  {%- endfor -%}
</div>

<script>
  (function () {
    var root = document.getElementById('bkp-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-bkp-buy]');
      if (!btn) return;
      var target = document.querySelector('.qty2') || document.querySelector('.product__submit-form') || document.getElementById('MainContent');
      if (!target) return;
      var top = target.getBoundingClientRect().top + window.pageYOffset - 110;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    });

    // Vídeos das faixas: tocam mudos só quando visíveis; botão liga o som.
    var vids = root.querySelectorAll('video[data-bkp-video]');
    if (vids.length && 'IntersectionObserver' in window) {
      var vio = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          var v = en.target;
          if (en.isIntersecting) {
            if (v.preload === 'none') { v.preload = 'auto'; v.load(); }
            var p = v.play();
            if (p && p.catch) p.catch(function () {});
          } else {
            v.pause();
          }
        });
      }, { threshold: 0.35 });
      vids.forEach(function (v) { vio.observe(v); });
    }
    root.addEventListener('click', function (e) {
      var m = e.target.closest('[data-bkp-mute]');
      if (!m) return;
      var v = m.parentNode.querySelector('video');
      if (!v) return;
      v.muted = !v.muted;
      m.classList.toggle('is-on', !v.muted);
      m.setAttribute('aria-pressed', v.muted ? 'false' : 'true');
      m.setAttribute('aria-label', v.muted ? 'Ativar o som' : 'Desativar o som');
    });

    // Faixa azul "Quem usa": slider com um print grande por vez + avaliação real ao lado.
    root.querySelectorAll('[data-bkts]').forEach(function (el) {
      var tpl = el.querySelector('[data-bkts-p]');
      var P = tpl ? Array.prototype.slice.call(tpl.content.children) : [];
      var R = [];
      try { R = JSON.parse(el.querySelector('[data-bkts-r]').textContent) || []; } catch (e) {}
      if (!P.length) return;
      var stage = el.querySelector('.bkts__stage'), q = el.querySelector('.bkts__q'), cnt = el.querySelector('[data-bkts-c]'), th = el.querySelector('.bkts__thumbs');
      var noAuto = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      var i = 0, busy = false, paused = false, vis = false, pt = 0;
      if (!R.length) el.classList.add('bkts--noq');
      function pad(n) { return (n < 9 ? '0' : '') + (n + 1); }
      function img(k) { var d = P[k].cloneNode(true); d.className = 'bkts__img'; var t = document.createElement('span'); t.className = 'bkts__tag'; t.textContent = 'Story de cliente · Instagram'; d.appendChild(t); var im = d.querySelector('img'); if (im) im.loading = 'eager'; return d; }
      function quote(k) {
        var d = document.createElement('div'); d.className = 'bkts__qi';
        if (!R.length) return d;
        var r = R[k % R.length];
        d.innerHTML = '<span class="bkts__src"><i aria-hidden="true">★★★★★</i> <span></span></span><p class="bkts__name"></p><p class="bkts__quote"></p>';
        d.querySelector('.bkts__src span').textContent = r.p ? 'Avaliação verificada · ' + r.p : 'Avaliação verificada no site';
        d.querySelector('.bkts__name').textContent = r.n;
        d.querySelector('.bkts__quote').textContent = '“' + r.q + '”';
        return d;
      }
      function counter() { cnt.innerHTML = '<b>' + pad(i) + '</b> / ' + pad(P.length - 1); }
      function thumbs() {
        th.innerHTML = '';
        for (var s = 1; s <= Math.min(3, P.length - 1); s++) {
          (function (k) {
            var bt = document.createElement('button'); bt.type = 'button'; bt.className = 'bkts__th';
            bt.setAttribute('aria-label', 'Ver print ' + (k + 1));
            bt.appendChild(P[k].cloneNode(true));
            bt.addEventListener('click', function () { go(k, 'r'); hold(); });
            th.appendChild(bt);
          })((i + s) % P.length);
        }
      }
      function go(k, dir) {
        if (busy || k === i) return;
        busy = true;
        var oi = stage.querySelector('.bkts__img'), ni = img(k), oq = q.querySelector('.bkts__qi'), nq = quote(k);
        ni.classList.add('is-in-' + dir); stage.appendChild(ni);
        requestAnimationFrame(function () { requestAnimationFrame(function () {
          ni.classList.remove('is-in-' + dir);
          if (oi) oi.classList.add('is-out-' + dir);
          if (oq) oq.classList.add('is-out-' + dir);
        }); });
        setTimeout(function () {
          if (oq) oq.remove();
          nq.classList.add('is-in-' + dir); q.appendChild(nq);
          requestAnimationFrame(function () { requestAnimationFrame(function () { nq.classList.remove('is-in-' + dir); }); });
        }, 300);
        setTimeout(function () { if (oi) oi.remove(); busy = false; }, 650);
        i = k; counter(); thumbs();
      }
      function hold() { paused = true; clearTimeout(pt); pt = setTimeout(function () { paused = false; }, 8000); }
      el.querySelector('[data-bkts-n]').addEventListener('click', function () { go((i + 1) % P.length, 'r'); hold(); });
      el.querySelector('[data-bkts-v]').addEventListener('click', function () { go((i - 1 + P.length) % P.length, 'l'); hold(); });
      var sx = 0;
      stage.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; hold(); }, { passive: true });
      stage.addEventListener('touchend', function (e) {
        var dx = e.changedTouches[0].clientX - sx;
        if (Math.abs(dx) > 40) go(dx < 0 ? (i + 1) % P.length : (i - 1 + P.length) % P.length, dx < 0 ? 'r' : 'l');
      }, { passive: true });
      el.addEventListener('mouseenter', function () { paused = true; });
      el.addEventListener('mouseleave', function () { paused = false; });
      if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { vis = es[0].isIntersecting; }, { threshold: 0.3 }).observe(el); else vis = true;
      setInterval(function () { if (!paused && vis && !document.hidden && !noAuto) go((i + 1) % P.length, 'r'); }, 5000);
      stage.appendChild(img(0)); q.appendChild(quote(0)); counter(); thumbs();
    });

    // Entradas ao rolar (uma vez): títulos palavra a palavra, cards em sequência,
    // números dos selos do painel principal contando. Sem JS/reduced motion = estático.
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) return;
    root.classList.add('bkp--anim');

    function esc(t) { return t.replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    root.querySelectorAll('.bkp__h').forEach(function (h) {
      var txt = (h.textContent || '').trim();
      if (!txt) return;
      h.setAttribute('aria-label', txt);
      h.innerHTML = txt.split(/\s+/).map(function (w, i) {
        return '<span class="bkp__w" aria-hidden="true"><span style="transition-delay:' + (i * 70) + 'ms">' + esc(w) + '</span></span>';
      }).join(' ');
    });

    var groups = '.bkp__grid, .bkp__proofs, .bkp__faq, .bkp__list, .bkp__specs, .bkp__steps, .bkp__notes, .bkp__pcontent, .bkp__head';
    root.querySelectorAll(groups).forEach(function (g) {
      Array.prototype.forEach.call(g.children, function (c, i) {
        if (c.classList.contains('bkp__h')) return;
        c.classList.add('bkp__rv');
        c.style.setProperty('--d', Math.min(i, 7) * 90 + 'ms');
      });
    });

    function countUp(el) {
      var node = null;
      for (var k = el.childNodes.length - 1; k >= 0; k--) {
        if (el.childNodes[k].nodeType === 3 && el.childNodes[k].nodeValue.trim()) { node = el.childNodes[k]; break; }
      }
      if (!node) return;
      var m = node.nodeValue.trim().match(/^(\d{1,3})(\s.+)$/);
      if (!m) return;
      var target = parseInt(m[1], 10), rest = m[2], t0 = null;
      if (target < 2) return;
      function step(ts) {
        if (!t0) t0 = ts;
        var k = Math.min(1, (ts - t0) / 900), e = 1 - Math.pow(1 - k, 3);
        node.nodeValue = Math.round(target * e) + rest;
        if (k < 1) requestAnimationFrame(step);
      }
      node.nodeValue = '0' + rest;
      requestAnimationFrame(step);
    }

    var bio = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        var band = en.target;
        band.classList.add('is-in');
        setTimeout(function () {
          band.querySelectorAll('.bkp__rv').forEach(function (c) { c.style.setProperty('--d', '0ms'); });
        }, 1600);
        if (band.classList.contains('bkp__band--hero')) {
          band.querySelectorAll('.bkp__chip').forEach(countUp);
        }
        bio.unobserve(band);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    root.querySelectorAll('.bkp__band').forEach(function (b) { bio.observe(b); });

    // Barras de %VD da tabela: cada linha com um pequeno atraso.
    root.querySelectorAll('.bkp__vdbar').forEach(function (bar, i) { bar.style.setProperty('--d', Math.min(i, 14) * 70 + 'ms'); });

    // Texto que acende palavra a palavra conforme a rolagem ("Por que essa combinação").
    var scrubs = [];
    root.querySelectorAll('[data-bkp-scrub]').forEach(function (el) {
      var txt = (el.textContent || '').trim();
      if (!txt) return;
      el.setAttribute('aria-label', txt);
      el.innerHTML = txt.split(/\s+/).map(function (w) { return '<span class="bkp__sw" aria-hidden="true">' + esc(w) + '</span>'; }).join(' ');
      scrubs.push({ el: el, words: el.querySelectorAll('.bkp__sw'), lit: -1 });
    });

    // Liquid glass: reflexo segue o mouse; no celular, desliza com a rolagem.
    var gls = root.classList.contains('bkp--glass') ? Array.prototype.slice.call(root.querySelectorAll('.bkp__gl')) : [];
    gls.forEach(function (g) {
      var pn = g.querySelector('.bkp__panel, .bkp__why');
      if (!pn) return;
      pn.addEventListener('pointermove', function (e) {
        if (e.pointerType !== 'mouse') return;
        var r = pn.getBoundingClientRect();
        pn.style.setProperty('--mx', (e.clientX - r.left).toFixed(0) + 'px');
        pn.style.setProperty('--my', (e.clientY - r.top).toFixed(0) + 'px');
      });
      pn.addEventListener('pointerleave', function () { pn.style.removeProperty('--mx'); pn.style.removeProperty('--my'); });
    });

    // Card azul dos prints: reflexo do vidro segue o mouse; no celular, a rolagem.
    root.querySelectorAll('[data-bkp-navy]').forEach(function (w) {
      w.addEventListener('pointermove', function (e) {
        if (e.pointerType !== 'mouse') return;
        var r = w.getBoundingClientRect();
        w.style.setProperty('--mx', (e.clientX - r.left).toFixed(0) + 'px');
        w.style.setProperty('--my', (e.clientY - r.top).toFixed(0) + 'px');
      });
      w.addEventListener('pointerleave', function () { w.style.removeProperty('--mx'); w.style.removeProperty('--my'); });
      gls.push(w);
    });

    // Faixa "Em cada porção": anda sozinha e acelera com a velocidade da rolagem.
    var mqs = [];
    root.querySelectorAll('[data-bkp-mq]').forEach(function (t) { t.classList.add('is-js'); mqs.push({ t: t, x: 0, vis: false }); });
    if (mqs.length) {
      var mio = new IntersectionObserver(function (es) { es.forEach(function (e) { mqs.forEach(function (m) { if (m.t.parentNode === e.target) m.vis = e.isIntersecting; }); }); });
      mqs.forEach(function (m) { mio.observe(m.t.parentNode); });
    }

    var vh = window.innerHeight, lastY = window.pageYOffset, boost = 0, ticking = false;
    window.addEventListener('resize', function () { vh = window.innerHeight; }, { passive: true });
    function clamp(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
    function onScroll() {
      var y = window.pageYOffset;
      boost = Math.min(boost + Math.abs(y - lastY) * 0.12, 14);
      lastY = y;
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }
    function update() {
      ticking = false;
      scrubs.forEach(function (sc) {
        var r = sc.el.getBoundingClientRect();
        var p = clamp((vh * 0.9 - r.top) / (r.height + vh * 0.45));
        var n = Math.round(p * sc.words.length);
        if (n === sc.lit) return;
        for (var i = 0; i < sc.words.length; i++) sc.words[i].classList.toggle('is-lit', i < n);
        sc.lit = n;
      });
      gls.forEach(function (g) {
        var r = g.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) return;
        var p = clamp((vh - r.top) / (vh + r.height));
        g.style.setProperty('--gp', p.toFixed(3));
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    update();

    if (mqs.length) {
      (function loop() {
        boost *= 0.94;
        mqs.forEach(function (m) {
          if (!m.vis) return;
          var half = m.t.scrollWidth / 2;
          m.x -= 0.45 + boost;
          if (half > 0 && -m.x >= half) m.x += half;
          m.t.style.transform = 'translate3d(' + m.x.toFixed(2) + 'px,0,0)';
        });
        requestAnimationFrame(loop);
      })();
    }
  })();
</script>

{%- style -%}
  .bkp{--bk-navy:#232b66;--bk-navy2:#3a44a0;--bk-brand:#323c91;--bk-lime:#c4d78a;--bk-ice:#f5f6fb;--bk-line:#e3e6f1;--bk-ink:#1b2150;--bk-muted:#5b6183;--bk-soft:#d6d9f2}
  .bkp__band{padding:72px 0}
  .bkp__band--ice{background:var(--bk-ice)}
  .bkp__band--white{background:#fff}
  .bkp__band.bkp__band--navy{background:#fff;padding:56px 0;color:var(--bk-ink)}
  .bkp__band--navy .bkp__wrap{position:relative;left:50%;transform:translateX(-50%);isolation:isolate;width:min(1360px,calc(100vw - 48px));max-width:none;margin:0;padding:44px 0 4px;border-radius:26px;overflow:hidden;background:linear-gradient(180deg,#f7f8fd 0%,#eef1fb 100%);box-shadow:inset 0 1px 0 #fff,0 18px 50px rgba(27,37,96,.10)}
  .bkp__band--navy .bkp__wrap::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;background:linear-gradient(140deg,rgba(42,58,214,.28),rgba(42,58,214,.06) 40%,rgba(42,58,214,.18));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none;z-index:3}
  .bkp__band--navy .bkp__wrap::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:0;background:radial-gradient(560px circle at var(--mx,calc(15% + var(--gp,.5) * 70%)) var(--my,0%),rgba(92,118,255,.10),rgba(92,118,255,0) 60%)}
  .bkp__band--navy .bkp__wrap>*:not(.bkp__orbs){position:relative;z-index:1}
  .bkp--glass .bkp__band--navy .bkp__orbs{border-radius:26px}
  .bkp--glass .bkp__band--navy .bkp__orbs i:nth-child(n){opacity:.45;filter:blur(70px);width:28%}
  .bkp__band--navy .bkp__head{padding:0 24px}
  .bkp__band--navy .bkp__eb{display:inline-flex;align-items:center;gap:8px;background:rgba(42,58,214,.08);border:1px solid rgba(42,58,214,.35);color:#2a3ad6;font-weight:800;padding:7px 14px;border-radius:999px}
  .bkp__band--navy .bkp__eb::before{content:"";width:8px;height:8px;border-radius:50%;background:#2a3ad6;animation:bkpPulse 1.6s infinite}
  @keyframes bkpPulse{0%{box-shadow:0 0 0 0 rgba(42,58,214,.55)}70%{box-shadow:0 0 0 10px rgba(42,58,214,0)}100%{box-shadow:0 0 0 0 rgba(42,58,214,0)}}
  .bkp__band--navy .bkp__h{color:var(--bk-navy);font-size:clamp(28px,3.6vw,46px);font-weight:900;letter-spacing:-.02em}
  .bkp__band--navy .bkp__h .bkp__w:last-child>span{background:linear-gradient(90deg,#1d2aa8,#3a52ff 40%,#8ea0ff 50%,#3a52ff 60%,#1d2aa8);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:bkpShine 4s linear infinite}
  @keyframes bkpShine{to{background-position:200% center}}
  .bkp__band--navy .bkp__sub{color:var(--bk-muted)}
  .bkts{display:grid;grid-template-columns:3fr 4fr 5fr;gap:40px;padding:8px 48px 44px;align-items:stretch}
  .bkts__meta{display:flex;flex-direction:column;justify-content:space-between;min-width:0}
  .bkts__count{font:600 14px/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:#5c6fe0;letter-spacing:.08em}
  .bkts__count b{color:#1d2aa8;font-size:30px}
  .bkts__vert{writing-mode:vertical-rl;transform:rotate(180deg);font-size:12px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#5c6fe0;margin:22px 0}
  .bkts__thumbs{display:flex;gap:10px}
  .bkts__th{position:relative;width:76px;aspect-ratio:9/16;border-radius:14px;overflow:hidden;padding:0;cursor:pointer;opacity:.8;background:#dfe4fb;border:2px solid rgba(42,58,214,.35);box-shadow:0 10px 24px rgba(29,42,168,.18);transition:opacity .3s ease,transform .3s ease}
  .bkts__th:hover,.bkts__th:focus-visible{opacity:1;transform:translateY(-4px)}
  .bkts__th .bkp__proof,.bkts__img{position:absolute;inset:0;margin:0;border:0;border-radius:0;box-shadow:none;background:none}
  .bkts__th img,.bkts__img img{display:block;width:100%;height:100%;object-fit:cover}
  .bkts__stage{position:relative;justify-self:center;height:540px;aspect-ratio:9/16;border-radius:26px;overflow:hidden;background:#0d1450;padding:0;box-shadow:0 0 0 3px rgba(42,58,214,.22),0 30px 60px rgba(29,42,168,.28)}
  .bkts__img{transition:transform .6s cubic-bezier(.4,0,.2,1),opacity .6s cubic-bezier(.4,0,.2,1)}
  .bkts__img.is-in-r{transform:translateY(100%);opacity:0}.bkts__img.is-in-l{transform:translateY(-100%);opacity:0}
  .bkts__img.is-out-r{transform:translateY(-100%);opacity:0}.bkts__img.is-out-l{transform:translateY(100%);opacity:0}
  .bkts__tag{position:absolute;left:14px;bottom:14px;z-index:2;font-size:11.5px;font-weight:600;color:#fff;background:rgba(13,18,80,.45);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.35);padding:6px 11px;border-radius:999px}
  .bkts__txt{display:flex;flex-direction:column;justify-content:space-between;gap:24px;padding:30px 30px 26px;border-radius:24px;color:#fff;background:radial-gradient(500px 260px at 10% 0%,rgba(120,140,255,.55),transparent 60%),linear-gradient(140deg,rgba(42,58,214,.94) 0%,rgba(29,42,168,.95) 50%,rgba(20,28,116,.97) 100%);border:1px solid rgba(255,255,255,.35);-webkit-backdrop-filter:blur(20px) saturate(170%);backdrop-filter:blur(20px) saturate(170%);box-shadow:inset 0 1px 0 rgba(255,255,255,.5),inset 0 -1px 0 rgba(255,255,255,.1),0 24px 60px rgba(29,42,168,.35);min-width:0}
  .bkts__q{position:relative;overflow:hidden;min-height:250px;display:flex;align-items:center}
  .bkts__qi{transition:transform .6s cubic-bezier(.4,0,.2,1),opacity .6s ease}
  .bkts__qi.is-out-r{transform:translateX(-50px);opacity:0}.bkts__qi.is-out-l{transform:translateX(50px);opacity:0}
  .bkts__qi.is-in-r{transform:translateX(50px);opacity:0}.bkts__qi.is-in-l{transform:translateX(-50px);opacity:0}
