  .bkp--glass .bkp__band--white .bkp__card,.bkp--glass .bkp__band--white .bkp__step,.bkp--glass .bkp__band--white .bkp__q{background:linear-gradient(180deg,rgba(245,246,251,.95),rgba(236,238,248,.75));border-color:rgba(255,255,255,.9)}
